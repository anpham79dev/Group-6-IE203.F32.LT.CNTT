<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DoiChuyenBay" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_04">
    <bpmn:participant id="Participant_MoMo_FlightExchange" name="Quy trình Đổi chuyến bay trên MoMo" processRef="Process_DoiChuyenBay" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DoiChuyenBay" isExecutable="false">
    <bpmn:laneSet id="LaneSet_04">
      <bpmn:lane id="Lane_KhachHang" name="Khách hàng">
        <bpmn:flowNodeRef>Start_YeuCauDoiVe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChonChuyenBayMoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KhachDongYPhi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KhachHuyYeuCauDoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XacNhanChiPhiDieuKien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XacThucThanhToanPhiDoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DoiVeThanhCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_GiuNguyenVeCu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClientApp" name="Giao diện MoMo Client App">
        <bpmn:flowNodeRef>Task_HienThiDanhSachChuyenMoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KhongCoChuyenPhuHop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HienThiBangPhanRaPhiDoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThongBaoDoiVeThanhCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThongBaoHetChoHoanTien</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BackendMoMo" name="Backend MoMo Travel">
        <bpmn:flowNodeRef>Task_KiemTraDieuKienVeGoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DieuKienDoiVe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TruyVanLichBayMoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CoChuyenPhuHop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TinhToanCauTrucPhiDoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HoTroDoiTuDongAPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSauKiemTraPhi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KenhTaiPhatHanh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuiLenhReissueSangHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinKenhReissue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KetQuaReissue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapNhatVeMoiApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HuyThanhToanHoanPhiDoi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="Cổng Thanh toán MoMo">
        <bpmn:flowNodeRef>Gateway_XacThucThanhCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_XacThucThatBai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XuLyTrichTienPhiDoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KetQuaThanhToanPhiDoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ThanhToanPhiThatBai</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="Bộ phận CSKH MoMo Travel">
        <bpmn:flowNodeRef>Task_TiepNhanTicketDoiThuCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LienHeHangBaoPhiGuiLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TaiXuatVeThuCong</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HangBay" name="Hệ thống Hãng bay (CRS/GDS)">
        <bpmn:flowNodeRef>Task_TraVeDanhSachChuyenBayMoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XuLyReissueVaCapVeMoi</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_YeuCauDoiVe" name="Khách hàng chọn Đổi chuyến bay">
      <bpmn:outgoing>D_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_KiemTraDieuKienVeGoc" name="Kiểm tra điều kiện hạng vé gốc (Fare Rules)">
      <bpmn:incoming>D_01</bpmn:incoming>
      <bpmn:outgoing>D_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_01" sourceRef="Start_YeuCauDoiVe" targetRef="Task_KiemTraDieuKienVeGoc" />
    <bpmn:exclusiveGateway id="Gateway_DieuKienDoiVe" name="Vé được phép đổi?">
      <bpmn:incoming>D_02</bpmn:incoming>
      <bpmn:outgoing>D_DuocDoi</bpmn:outgoing>
      <bpmn:outgoing>D_KhongDuocDoi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_02" sourceRef="Task_KiemTraDieuKienVeGoc" targetRef="Gateway_DieuKienDoiVe" />
    <bpmn:sequenceFlow id="D_KhongDuocDoi" name="Không" sourceRef="Gateway_DieuKienDoiVe" targetRef="End_GiuNguyenVeCu" />
    <bpmn:task id="Task_TruyVanLichBayMoi" name="Gửi truy vấn chuyến bay mới sang GDS">
      <bpmn:incoming>D_DuocDoi</bpmn:incoming>
      <bpmn:outgoing>D_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_DuocDoi" name="Có" sourceRef="Gateway_DieuKienDoiVe" targetRef="Task_TruyVanLichBayMoi" />
    <bpmn:task id="Task_TraVeDanhSachChuyenBayMoi" name="Trả về danh sách chuyến bay &amp; chỗ trống">
      <bpmn:incoming>D_03</bpmn:incoming>
      <bpmn:outgoing>D_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_03" sourceRef="Task_TruyVanLichBayMoi" targetRef="Task_TraVeDanhSachChuyenBayMoi" />
    <bpmn:exclusiveGateway id="Gateway_CoChuyenPhuHop" name="Có chuyến bay phù hợp còn chỗ?">
      <bpmn:incoming>D_04</bpmn:incoming>
      <bpmn:outgoing>D_CoChuyen_Co</bpmn:outgoing>
      <bpmn:outgoing>D_CoChuyen_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_04" sourceRef="Task_TraVeDanhSachChuyenBayMoi" targetRef="Gateway_CoChuyenPhuHop" />
    <bpmn:endEvent id="End_KhongCoChuyenPhuHop" name="Không có chuyến phù hợp - giữ nguyên vé cũ">
      <bpmn:incoming>D_CoChuyen_Khong</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_CoChuyen_Khong" name="Không" sourceRef="Gateway_CoChuyenPhuHop" targetRef="End_KhongCoChuyenPhuHop" />
    <bpmn:task id="Task_HienThiDanhSachChuyenMoi" name="Hiển thị danh sách chuyến bay để khách chọn">
      <bpmn:incoming>D_CoChuyen_Co</bpmn:incoming>
      <bpmn:outgoing>D_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_CoChuyen_Co" name="Có" sourceRef="Gateway_CoChuyenPhuHop" targetRef="Task_HienThiDanhSachChuyenMoi" />
    <bpmn:task id="Task_ChonChuyenBayMoi" name="Chọn chuyến bay / ngày bay mới">
      <bpmn:incoming>D_05</bpmn:incoming>
      <bpmn:outgoing>D_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_05" sourceRef="Task_HienThiDanhSachChuyenMoi" targetRef="Task_ChonChuyenBayMoi" />
    <bpmn:task id="Task_TinhToanCauTrucPhiDoi" name="Tính toán phí đổi = Phí hãng + Chênh lệch + Phí DV">
      <bpmn:incoming>D_06</bpmn:incoming>
      <bpmn:outgoing>D_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_06" sourceRef="Task_ChonChuyenBayMoi" targetRef="Task_TinhToanCauTrucPhiDoi" />
    <bpmn:exclusiveGateway id="Gateway_HoTroDoiTuDongAPI" name="Hỗ trợ đổi tự động qua API?">
      <bpmn:incoming>D_07</bpmn:incoming>
      <bpmn:outgoing>D_APIDoiTuDong_Co</bpmn:outgoing>
      <bpmn:outgoing>D_APIDoiTuDong_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_07" sourceRef="Task_TinhToanCauTrucPhiDoi" targetRef="Gateway_HoTroDoiTuDongAPI" />
    <bpmn:task id="Task_TiepNhanTicketDoiThuCong" name="Tạo ticket hỗ trợ và kiểm tra phí thủ công với Hãng">
      <bpmn:incoming>D_APIDoiTuDong_Khong</bpmn:incoming>
      <bpmn:outgoing>D_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_APIDoiTuDong_Khong" name="Không" sourceRef="Gateway_HoTroDoiTuDongAPI" targetRef="Task_TiepNhanTicketDoiThuCong" />
    <bpmn:task id="Task_LienHeHangBaoPhiGuiLink" name="Báo phí đổi và gửi yêu cầu thanh toán cho KH">
      <bpmn:incoming>D_08</bpmn:incoming>
      <bpmn:outgoing>D_ToMergePhi1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_08" sourceRef="Task_TiepNhanTicketDoiThuCong" targetRef="Task_LienHeHangBaoPhiGuiLink" />
    <bpmn:exclusiveGateway id="Gateway_MergeSauKiemTraPhi">
      <bpmn:incoming>D_APIDoiTuDong_Co</bpmn:incoming>
      <bpmn:incoming>D_ToMergePhi1</bpmn:incoming>
      <bpmn:outgoing>D_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_APIDoiTuDong_Co" name="Có" sourceRef="Gateway_HoTroDoiTuDongAPI" targetRef="Gateway_MergeSauKiemTraPhi" />
    <bpmn:sequenceFlow id="D_ToMergePhi1" sourceRef="Task_LienHeHangBaoPhiGuiLink" targetRef="Gateway_MergeSauKiemTraPhi" />
    <bpmn:task id="Task_HienThiBangPhanRaPhiDoi" name="Hiển thị bảng chi tiết phí đổi vé và điều khoản">
      <bpmn:incoming>D_09</bpmn:incoming>
      <bpmn:outgoing>D_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_09" sourceRef="Gateway_MergeSauKiemTraPhi" targetRef="Task_HienThiBangPhanRaPhiDoi" />
    <bpmn:exclusiveGateway id="Gateway_KhachDongYPhi" name="Khách hàng đồng ý mức phí đổi?">
      <bpmn:incoming>D_10</bpmn:incoming>
      <bpmn:outgoing>D_DongYPhi_Co</bpmn:outgoing>
      <bpmn:outgoing>D_DongYPhi_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_10" sourceRef="Task_HienThiBangPhanRaPhiDoi" targetRef="Gateway_KhachDongYPhi" />
    <bpmn:endEvent id="End_KhachHuyYeuCauDoi" name="Khách hủy yêu cầu đổi - giữ nguyên vé cũ">
      <bpmn:incoming>D_DongYPhi_Khong</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_DongYPhi_Khong" name="Không đồng ý" sourceRef="Gateway_KhachDongYPhi" targetRef="End_KhachHuyYeuCauDoi" />
    <bpmn:task id="Task_XacNhanChiPhiDieuKien" name="Xác nhận đồng ý chi phí và điều kiện đổi">
      <bpmn:incoming>D_DongYPhi_Co</bpmn:incoming>
      <bpmn:outgoing>D_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_DongYPhi_Co" name="Đồng ý" sourceRef="Gateway_KhachDongYPhi" targetRef="Task_XacNhanChiPhiDieuKien" />
    <bpmn:task id="Task_XacThucThanhToanPhiDoi" name="Xác thực sinh trắc học / OTP thanh toán">
      <bpmn:incoming>D_11</bpmn:incoming>
      <bpmn:outgoing>D_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_11" sourceRef="Task_XacNhanChiPhiDieuKien" targetRef="Task_XacThucThanhToanPhiDoi" />
    <bpmn:exclusiveGateway id="Gateway_XacThucThanhCong" name="Xác thực bảo mật thành công?">
      <bpmn:incoming>D_12</bpmn:incoming>
      <bpmn:outgoing>D_XacThuc_Co</bpmn:outgoing>
      <bpmn:outgoing>D_XacThuc_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_12" sourceRef="Task_XacThucThanhToanPhiDoi" targetRef="Gateway_XacThucThanhCong" />
    <bpmn:endEvent id="End_XacThucThatBai" name="Xác thực thất bại - hủy yêu cầu đổi vé">
      <bpmn:incoming>D_XacThuc_Khong</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_XacThuc_Khong" name="Thất bại" sourceRef="Gateway_XacThucThanhCong" targetRef="End_XacThucThatBai" />
    <bpmn:task id="Task_XuLyTrichTienPhiDoi" name="Xử lý trích tiền phí đổi vé">
      <bpmn:incoming>D_XacThuc_Co</bpmn:incoming>
      <bpmn:outgoing>D_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_XacThuc_Co" name="Thành công" sourceRef="Gateway_XacThucThanhCong" targetRef="Task_XuLyTrichTienPhiDoi" />
    <bpmn:exclusiveGateway id="Gateway_KetQuaThanhToanPhiDoi" name="Thanh toán thành công?">
      <bpmn:incoming>D_13</bpmn:incoming>
      <bpmn:outgoing>D_PayPhi_Khong</bpmn:outgoing>
      <bpmn:outgoing>D_PayPhi_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_13" sourceRef="Task_XuLyTrichTienPhiDoi" targetRef="Gateway_KetQuaThanhToanPhiDoi" />
    <bpmn:endEvent id="End_ThanhToanPhiThatBai" name="Đổi vé thất bại do lỗi thanh toán">
      <bpmn:incoming>D_PayPhi_Khong</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_PayPhi_Khong" name="Không" sourceRef="Gateway_KetQuaThanhToanPhiDoi" targetRef="End_ThanhToanPhiThatBai" />
    <bpmn:exclusiveGateway id="Gateway_KenhTaiPhatHanh" name="Kênh tái phát hành vé?">
      <bpmn:incoming>D_PayPhi_Co</bpmn:incoming>
      <bpmn:outgoing>D_Kenh_TuDong</bpmn:outgoing>
      <bpmn:outgoing>D_Kenh_ThuCong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_PayPhi_Co" name="Có" sourceRef="Gateway_KetQuaThanhToanPhiDoi" targetRef="Gateway_KenhTaiPhatHanh" />
    <bpmn:task id="Task_GuiLenhReissueSangHang" name="Gửi lệnh Re-issue vé sang Hãng bay">
      <bpmn:incoming>D_Kenh_TuDong</bpmn:incoming>
      <bpmn:outgoing>D_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_Kenh_TuDong" name="Tự động qua API" sourceRef="Gateway_KenhTaiPhatHanh" targetRef="Task_GuiLenhReissueSangHang" />
    <bpmn:task id="Task_TaiXuatVeThuCong" name="CSKH thao tác tái xuất vé thủ công với Hãng">
      <bpmn:incoming>D_Kenh_ThuCong</bpmn:incoming>
      <bpmn:outgoing>D_ThuCongXong</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_Kenh_ThuCong" name="Thủ công qua CSKH" sourceRef="Gateway_KenhTaiPhatHanh" targetRef="Task_TaiXuatVeThuCong" />
    <bpmn:exclusiveGateway id="Gateway_JoinKenhReissue">
      <bpmn:incoming>D_14</bpmn:incoming>
      <bpmn:incoming>D_ThuCongXong</bpmn:incoming>
      <bpmn:outgoing>D_14b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_14" sourceRef="Task_GuiLenhReissueSangHang" targetRef="Gateway_JoinKenhReissue" />
    <bpmn:sequenceFlow id="D_ThuCongXong" sourceRef="Task_TaiXuatVeThuCong" targetRef="Gateway_JoinKenhReissue" />
    <bpmn:task id="Task_XuLyReissueVaCapVeMoi" name="Hủy chỗ cũ, xác nhận chỗ mới, cấp vé điện tử mới">
      <bpmn:incoming>D_14b</bpmn:incoming>
      <bpmn:outgoing>D_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_14b" sourceRef="Gateway_JoinKenhReissue" targetRef="Task_XuLyReissueVaCapVeMoi" />
    <bpmn:exclusiveGateway id="Gateway_KetQuaReissue" name="Re-issue thành công?">
      <bpmn:incoming>D_15</bpmn:incoming>
      <bpmn:outgoing>D_Reissue_Co</bpmn:outgoing>
      <bpmn:outgoing>D_Reissue_HetCho</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="D_15" sourceRef="Task_XuLyReissueVaCapVeMoi" targetRef="Gateway_KetQuaReissue" />
    <bpmn:task id="Task_HuyThanhToanHoanPhiDoi" name="Hủy giao dịch thanh toán và hoàn 100% phí đổi về Ví">
      <bpmn:incoming>D_Reissue_HetCho</bpmn:incoming>
      <bpmn:outgoing>D_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_Reissue_HetCho" name="Hết chỗ chuyến mới" sourceRef="Gateway_KetQuaReissue" targetRef="Task_HuyThanhToanHoanPhiDoi" />
    <bpmn:task id="Task_ThongBaoHetChoHoanTien" name="Thông báo hết chỗ và giữ nguyên vé cũ">
      <bpmn:incoming>D_16</bpmn:incoming>
      <bpmn:outgoing>D_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_16" sourceRef="Task_HuyThanhToanHoanPhiDoi" targetRef="Task_ThongBaoHetChoHoanTien" />
    <bpmn:endEvent id="End_GiuNguyenVeCu" name="Giữ nguyên vé cũ và hoàn tiền phí đổi">
      <bpmn:incoming>D_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_17" sourceRef="Task_ThongBaoHetChoHoanTien" targetRef="End_GiuNguyenVeCu" />
    <bpmn:task id="Task_CapNhatVeMoiApp" name="Cập nhật thông tin vé mới vào Quản lý đặt chỗ">
      <bpmn:incoming>D_Reissue_Co</bpmn:incoming>
      <bpmn:outgoing>D_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_Reissue_Co" name="Thành công" sourceRef="Gateway_KetQuaReissue" targetRef="Task_CapNhatVeMoiApp" />
    <bpmn:task id="Task_ThongBaoDoiVeThanhCong" name="Gửi thông báo và vé điện tử mới cho khách hàng">
      <bpmn:incoming>D_18</bpmn:incoming>
      <bpmn:outgoing>D_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="D_18" sourceRef="Task_CapNhatVeMoiApp" targetRef="Task_ThongBaoDoiVeThanhCong" />
    <bpmn:endEvent id="End_DoiVeThanhCong" name="Đổi chuyến bay thành công">
      <bpmn:incoming>D_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_19" sourceRef="Task_ThongBaoDoiVeThanhCong" targetRef="End_DoiVeThanhCong" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_DoiChuyenBay">
    <bpmndi:BPMNPlane id="Plane_Process_DoiChuyenBay" bpmnElement="Collaboration_04">
      <bpmndi:BPMNShape id="Participant_MoMo_FlightExchange_di" bpmnElement="Participant_MoMo_FlightExchange" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="5610" height="1860" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_KhachHang_di" bpmnElement="Lane_KhachHang" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="5580" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ClientApp_di" bpmnElement="Lane_ClientApp" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="5580" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BackendMoMo_di" bpmnElement="Lane_BackendMoMo" isHorizontal="true">
        <dc:Bounds x="190" y="800" width="5580" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payment_di" bpmnElement="Lane_Payment" isHorizontal="true">
        <dc:Bounds x="190" y="1160" width="5580" height="360" />
