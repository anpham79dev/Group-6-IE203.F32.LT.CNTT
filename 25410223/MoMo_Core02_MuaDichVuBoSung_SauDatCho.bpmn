<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Core02_MuaDichVuBoSung_SauDatCho" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:collaboration id="Collab_Core02_MuaDichVuBoSung_SauDatCho">
    <ns0:participant id="Part_Core02_MuaDichVuBoSung_SauDatCho" name="Quy trình Mua thêm dịch vụ bổ sung sau đặt chỗ (Hành lý, Chỗ ngồi, Suất ăn, Bảo hiểm) MoMo" processRef="Proc_Core02_MuaDichVuBoSung_SauDatCho" />
  </ns0:collaboration>
  <ns0:process id="Proc_Core02_MuaDichVuBoSung_SauDatCho" name="Quy trình Mua thêm dịch vụ bổ sung sau đặt chỗ (Hành lý, Chỗ ngồi, Suất ăn, Bảo hiểm) MoMo" isExecutable="false">
    <ns0:laneSet id="LaneSet_Core02_MuaDichVuBoSung_SauDatCho">
      <ns0:lane id="Lane_Cust" name="KHÁCH HÀNG (Customer)">
        <ns0:flowNodeRef>s1</ns0:flowNodeRef>
        <ns0:flowNodeRef>t1</ns0:flowNodeRef>
        <ns0:flowNodeRef>t3</ns0:flowNodeRef>
        <ns0:flowNodeRef>t5</ns0:flowNodeRef>
        <ns0:flowNodeRef>e1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_App" name="GIAO DIỆN MOMO CLIENT APP">
        <ns0:flowNodeRef>t2</ns0:flowNodeRef>
        <ns0:flowNodeRef>g1</ns0:flowNodeRef>
        <ns0:flowNodeRef>t4</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Backend" name="HE THONG BACKEND MOMO TRAVEL">
        <ns0:flowNodeRef>t6</ns0:flowNodeRef>
        <ns0:flowNodeRef>g2</ns0:flowNodeRef>
        <ns0:flowNodeRef>e2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Payment" name="CONG THANH TOAN MOMO">
        <ns0:flowNodeRef>t7</ns0:flowNodeRef>
        <ns0:flowNodeRef>g3</ns0:flowNodeRef>
        <ns0:flowNodeRef>e3</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Airline" name="HE THONG HANG BAY (ANCILLARY API)">
        <ns0:flowNodeRef>t8</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="s1" name="Nhu cầu mua thêm dịch vụ hành lý/chỗ ngồi">
      <ns0:outgoing>f1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="t1" name="Truy cập mục Quản lý đặt chỗ &amp; Chọn mã PNR vé máy bay">
      <ns0:incoming>f1</ns0:incoming>
      <ns0:outgoing>f2</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="t2" name="Kiểm tra điều kiện vé &amp; Đồng bộ sơ đồ ghế/hành lý real-time">
      <ns0:incoming>f2</ns0:incoming>
      <ns0:outgoing>f3</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="g1" name="Vé đủ điều kiện mua thêm (Chưa Check-in)?">
      <ns0:incoming>f3</ns0:incoming>
      <ns0:outgoing>f4</ns0:outgoing>
      <ns0:outgoing>f5</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="t3" name="Lựa chọn gói hành lý (15-40kg), Vị trí chỗ ngồi (Seat Map) &amp; Suất ăn">
      <ns0:incoming>f4</ns0:incoming>
      <ns0:outgoing>f6</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="t4" name="Hiển thị thông báo vé đã Check-in, hướng dẫn mua tại sân bay">
      <ns0:incoming>f5</ns0:incoming>
      <ns0:outgoing>e2</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="t5" name="Xác nhận giỏ hàng dịch vụ &amp; Thanh toán khoản phí bổ sung">
      <ns0:incoming>f6</ns0:incoming>
      <ns0:outgoing>f7</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="t6" name="Gửi yêu cầu cấp chứng từ phụ trợ điện tử EMD sang Hãng bay">
      <ns0:incoming>f7</ns0:incoming>
      <ns0:outgoing>f8</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="g2" name="Cấp chứng từ EMD thành công?">
      <ns0:incoming>f8</ns0:incoming>
      <ns0:outgoing>f9</ns0:outgoing>
      <ns0:outgoing>f10</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="t7" name="Trích tiền nguồn ví &amp; Hạch toán phí dịch vụ bổ sung">
      <ns0:incoming>f9</ns0:incoming>
      <ns0:outgoing>f11</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="t8" name="Cập nhật EMD vào PNR &amp; Gửi email xác nhận vé mới">
      <ns0:incoming>f11</ns0:incoming>
      <ns0:outgoing>e1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="g3" name="Thanh toán thành công?">
      <ns0:incoming>f10</ns0:incoming>
      <ns0:outgoing>f12</ns0:outgoing>
      <ns0:outgoing>f13</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="e1" name="Cập nhật dịch vụ bổ sung vào vé thành công" />
    <ns0:endEvent id="e2" name="Từ chối mua thêm dịch vụ trực tuyến" />
    <ns0:endEvent id="e3" name="Tạo Ticket CSKH xử lý EMD thủ công / Hoàn tiền" />
    <ns0:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <ns0:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <ns0:sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <ns0:sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="Đủ điều kiện" />
    <ns0:sequenceFlow id="f5" sourceRef="g1" targetRef="t4" name="Đã Check-in / Khóa PNR" />
    <ns0:sequenceFlow id="f6" sourceRef="t3" targetRef="t5" />
    <ns0:sequenceFlow id="f7" sourceRef="t5" targetRef="t6" />
    <ns0:sequenceFlow id="f8" sourceRef="t6" targetRef="g2" />
    <ns0:sequenceFlow id="f9" sourceRef="g2" targetRef="t7" name="EMD thành công" />
    <ns0:sequenceFlow id="f10" sourceRef="g2" targetRef="g3" name="Lỗi EMD Hãng" />
    <ns0:sequenceFlow id="f11" sourceRef="t7" targetRef="t8" name="Trích tiền OK" />
    <ns0:sequenceFlow id="f12" sourceRef="g3" targetRef="e3" name="Chuyển CSKH" />
    <ns0:sequenceFlow id="f13" sourceRef="g3" targetRef="e2" name="Hủy đơn" />
  </ns0:process>
  <ns1:BPMNDiagram id="Diag_Core02_MuaDichVuBoSung_SauDatCho">
    <ns1:BPMNPlane id="Plane_Core02_MuaDichVuBoSung_SauDatCho" bpmnElement="Collab_Core02_MuaDichVuBoSung_SauDatCho">
      <ns1:BPMNShape id="Part_Core02_MuaDichVuBoSung_SauDatCho_di" bpmnElement="Part_Core02_MuaDichVuBoSung_SauDatCho" isHorizontal="true" />
      <ns1:BPMNShape id="Lane_Cust_di" bpmnElement="Lane_Cust" isHorizontal="true">
        <ns2:Bounds x="160" y="50" width="1400" height="160" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true">
        <ns2:Bounds x="160" y="210" width="1400" height="160" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_Backend_di" bpmnElement="Lane_Backend" isHorizontal="true">
        <ns2:Bounds x="160" y="370" width="1400" height="160" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_Payment_di" bpmnElement="Lane_Payment" isHorizontal="true">
        <ns2:Bounds x="160" y="530" width="1400" height="160" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_Airline_di" bpmnElement="Lane_Airline" isHorizontal="true">
        <ns2:Bounds x="160" y="690" width="1400" height="160" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="s1_di" bpmnElement="s1">
        <ns2:Bounds x="240" y="95" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="t1_di" bpmnElement="t1">
