      </ns1:BPMNShape>
      <ns1:BPMNShape id="g2_di" bpmnElement="g2">
        <ns2:Bounds x="1120" y="415" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="t7_di" bpmnElement="t7">
        <ns2:Bounds x="1230" y="575" width="100" height="70" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="t8_di" bpmnElement="t8">
        <ns2:Bounds x="1340" y="735" width="100" height="70" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="g3_di" bpmnElement="g3">
        <ns2:Bounds x="1450" y="575" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="e1_di" bpmnElement="e1">
        <ns2:Bounds x="240" y="95" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="e2_di" bpmnElement="e2">
        <ns2:Bounds x="350" y="415" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="e3_di" bpmnElement="e3">
        <ns2:Bounds x="460" y="575" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNEdge id="f1_di" bpmnElement="f1">
        <ns3:waypoint x="250" y="100" />
        <ns3:waypoint x="350" y="100" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="f2_di" bpmnElement="f2">
        <ns3:waypoint x="250" y="100" />
        <ns3:waypoint x="350" y="100" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="f3_di" bpmnElement="f3">
        <ns3:waypoint x="250" y="100" />
