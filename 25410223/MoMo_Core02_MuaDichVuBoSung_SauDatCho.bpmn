      <bpmndi:BPMNShape id="Lane_Airline_di" bpmnElement="Lane_Airline" isHorizontal="true">
        <dc:Bounds x="190" y="1020" width="3070" height="240" />
      </bpmndi:BPMNShape>
      
      <!-- Nodes -->
      <!-- Lane_Cust: cy = 180 -->
