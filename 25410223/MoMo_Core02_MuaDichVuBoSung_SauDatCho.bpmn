        <di:waypoint x="2080" y="660" />
      </bpmndi:BPMNEdge>
      
      <!-- f9: g2 -> t7 (Cấp EMD thành công) -->
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
