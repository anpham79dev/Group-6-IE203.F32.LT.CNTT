<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Core02_MuaDichVuBoSung_SauDatCho" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Core02_MuaDichVuBoSung_SauDatCho">
    <bpmn:participant id="Part_Core02_MuaDichVuBoSung_SauDatCho" name="Quy trình Mua thêm dịch vụ bổ sung sau đặt chỗ MoMo" processRef="Proc_Core02_MuaDichVuBoSung_SauDatCho" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Core02_MuaDichVuBoSung_SauDatCho" name="Quy trình Mua thêm dịch vụ bổ sung sau đặt chỗ MoMo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Core02_MuaDichVuBoSung_SauDatCho">
      <bpmn:lane id="Lane_Cust" name="KHÁCH HÀNG (Customer)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="GIAO DIỆN MOMO CLIENT APP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="HỆ THỐNG BACKEND MOMO TRAVEL">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="CỔNG THANH TOÁN MOMO">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Airline" name="HỆ THỐNG HÃNG BAY (ANCILLARY API)">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Nhu cầu mua dịch vụ bổ sung">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Chọn PNR vé trong Quản lý đặt chỗ">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Kiểm tra điều kiện &amp; Đồng bộ sơ đồ ghế/hành lý">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Vé chưa Check-in?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Chọn gói hành lý, Chỗ ngồi (Seat Map) &amp; Suất ăn">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Thông báo PNR đã Check-in, mua tại sân bay">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Xác nhận giỏ hàng &amp; Thanh toán khoản chi phí bổ sung">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Gửi yêu cầu cấp chứng từ EMD sang Hãng">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Cấp EMD OK?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Trích tiền nguồn ví &amp; Hạch toán dịch vụ bổ sung">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Cập nhật EMD vào PNR &amp; Gửi email vé mới">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="Thanh toán OK?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Cập nhật dịch vụ bổ sung thành công">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Từ chối mua online">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Chuyển CSKH xử lý EMD thủ công">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="Chưa Check-in" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f5" name="Đã Check-in" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t5" />
    <bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="g2" />
    <bpmn:sequenceFlow id="f9" name="Cấp EMD thành công" sourceRef="g2" targetRef="t7" />
    <bpmn:sequenceFlow id="f10" name="Lỗi EMD Hãng" sourceRef="g2" targetRef="g3" />
    <bpmn:sequenceFlow id="f11" name="Hạch toán OK" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f12" name="Lỗi trích tiền" sourceRef="g3" targetRef="e3" />
    <bpmn:sequenceFlow id="f13" name="Hủy mua" sourceRef="g3" targetRef="e2" />
    <bpmn:sequenceFlow id="f14" sourceRef="t4" targetRef="e2" />
    <bpmn:sequenceFlow id="f15" sourceRef="t8" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Core02_MuaDichVuBoSung_SauDatCho">
    <bpmndi:BPMNPlane id="Plane_Core02_MuaDichVuBoSung_SauDatCho" bpmnElement="Collab_Core02_MuaDichVuBoSung_SauDatCho">
      <bpmndi:BPMNShape id="Part_Core02_MuaDichVuBoSung_SauDatCho_di" bpmnElement="Part_Core02_MuaDichVuBoSung_SauDatCho" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="3100" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Cust_di" bpmnElement="Lane_Cust" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="3070" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="3070" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Backend_di" bpmnElement="Lane_Backend" isHorizontal="true">
        <dc:Bounds x="190" y="540" width="3070" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payment_di" bpmnElement="Lane_Payment" isHorizontal="true">
        <dc:Bounds x="190" y="780" width="3070" height="240" />
