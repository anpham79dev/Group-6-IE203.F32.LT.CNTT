          <dc:Bounds x="2797" y="928" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Lane_Airline: cy = 1140 -->
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8">
        <dc:Bounds x="2500" y="1095" width="210" height="90" />
      </bpmndi:BPMNShape>
      
      <!-- Lane_Cust: cy = 180 -->
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1">
        <dc:Bounds x="3020" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2996" y="208" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <!-- f1: s1 -> t1 -->
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="266" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>
      
      <!-- f2: t1 -> t2 -->
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="540" y="180" />
        <di:waypoint x="570" y="180" />
        <di:waypoint x="570" y="420" />
        <di:waypoint x="600" y="420" />
      </bpmndi:BPMNEdge>
      
      <!-- f3: t2 -> g1 -->
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="810" y="420" />
        <di:waypoint x="870" y="420" />
      </bpmndi:BPMNEdge>
      
      <!-- f5: g1 -> t4 (Đã Check-in) -->
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="920" y="420" />
