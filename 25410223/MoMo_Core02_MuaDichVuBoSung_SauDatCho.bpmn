      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="1470" y="180" />
        <di:waypoint x="1530" y="180" />
      </bpmndi:BPMNEdge>
      
      <!-- f7: t5 -> t6 -->
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="1750" y="180" />
        <di:waypoint x="1780" y="180" />
        <di:waypoint x="1780" y="660" />
        <di:waypoint x="1810" y="660" />
      </bpmndi:BPMNEdge>
      
      <!-- f8: t6 -> g2 -->
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
