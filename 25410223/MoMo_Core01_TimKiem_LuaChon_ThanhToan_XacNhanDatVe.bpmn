        <bpmndi:BPMNLabel>
          <dc:Bounds x="3430" y="208" width="77" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <!-- f1: s1 -> t1 -->
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="266" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>
      
      <!-- f2: t1 -> t2 -->
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
