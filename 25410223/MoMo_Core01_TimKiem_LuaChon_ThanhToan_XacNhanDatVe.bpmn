        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <!-- f4b: t3 -> t1 (loop back via upper channel y=90) -->
      <bpmndi:BPMNEdge id="f4b_di" bpmnElement="f4b">
        <di:waypoint x="1085" y="375" />
        <di:waypoint x="1085" y="90" />
        <di:waypoint x="435" y="90" />
        <di:waypoint x="435" y="135" />
      </bpmndi:BPMNEdge>
      
      <!-- f5: g1 -> t4 (Có) -->
