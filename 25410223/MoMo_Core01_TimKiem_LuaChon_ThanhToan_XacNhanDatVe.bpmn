        <di:waypoint x="2420" y="660" />
        <di:waypoint x="2480" y="660" />
      </bpmndi:BPMNEdge>
      
      <!-- f11: t7 -> t9 -->
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
