          <dc:Bounds x="910" y="188" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <!-- f6: t4 -> t5 -->
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
