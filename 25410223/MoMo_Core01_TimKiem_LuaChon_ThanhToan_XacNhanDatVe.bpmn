<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Core01_TimKiem_LuaChon_ThanhToan" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Core01_TimKiem_LuaChon_ThanhToan">
    <bpmn:participant id="Part_Core01_TimKiem_LuaChon_ThanhToan" name="Quy trình Tìm kiếm, Lựa chọn hành trình, Thanh toán và Xác nhận đặt vé MoMo" processRef="Proc_Core01_TimKiem_LuaChon_ThanhToan" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Core01_TimKiem_LuaChon_ThanhToan" name="Quy trình Tìm kiếm, Lựa chọn hành trình, Thanh toán và Xác nhận đặt vé MoMo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Core01_TimKiem_LuaChon_ThanhToan">
      <bpmn:lane id="Lane_Cust" name="KHÁCH HÀNG (Customer)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="GIAO DIỆN MOMO CLIENT APP">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="HỆ THỐNG BACKEND MOMO TRAVEL">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="CỔNG THANH TOÁN MOMO">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Airline" name="HỆ THỐNG HÃNG BAY / GDS / CRS">
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Phát sinh nhu cầu đi lại">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Nhập tiêu chí tìm kiếm (điểm đi, ngày, số khách)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>f4b</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Kiểm tra định dạng &amp; tiêu chí dữ liệu tìm kiếm">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Dữ liệu hợp lệ?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Hiển thị cảnh báo &amp; gợi ý sửa tiêu chí">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f4b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Lựa chọn chuyến bay &amp; nhập thông tin hành khách">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Tự động áp dụng mã ưu đãi &amp; dịch vụ ban đầu">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Gửi lệnh tạo PNR &amp; giữ chỗ tạm thời sang Hãng">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Có PNR giữ chỗ?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Xác nhận nguồn tiền &amp; xác thực thanh toán (Biometrics/OTP)">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Xử lý hủy giữ chỗ &amp; thông báo hết thời hạn">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Trích tiền tài khoản ví &amp; hạch toán tài chính">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g4" name="Hạch toán OK?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t10" name="Gửi lệnh phát hành vé máy bay điện tử (e-Ticket)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t11" name="Xử lý hoàn tiền ví &amp; thông báo lỗi xuất vé">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Đặt vé máy bay thành công &amp; Nhận e-Ticket">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Hủy giữ chỗ - Kết thúc">
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Giao dịch lỗi - Hoàn tiền">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" name="Không" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="f4b" sourceRef="t3" targetRef="t1" />
    <bpmn:sequenceFlow id="f5" name="Có" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f8" sourceRef="t6" targetRef="g2" />
    <bpmn:sequenceFlow id="f9" name="Có PNR" sourceRef="g2" targetRef="t7" />
    <bpmn:sequenceFlow id="f10" name="Thất bại" sourceRef="g2" targetRef="t8" />
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="t9" />
    <bpmn:sequenceFlow id="f12" sourceRef="t9" targetRef="g4" />
    <bpmn:sequenceFlow id="f13" name="Thành công" sourceRef="g4" targetRef="t10" />
    <bpmn:sequenceFlow id="f14" name="Lỗi / Không đủ tiền" sourceRef="g4" targetRef="t11" />
    <bpmn:sequenceFlow id="f15" name="Đã xuất vé" sourceRef="t10" targetRef="e1" />
    <bpmn:sequenceFlow id="f16" sourceRef="t8" targetRef="e2" />
    <bpmn:sequenceFlow id="f17" sourceRef="t11" targetRef="e3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Core01_TimKiem_LuaChon_ThanhToan">
    <bpmndi:BPMNPlane id="Plane_Core01_TimKiem_LuaChon_ThanhToan" bpmnElement="Collab_Core01_TimKiem_LuaChon_ThanhToan">
      <bpmndi:BPMNShape id="Part_Core01_TimKiem_LuaChon_ThanhToan_di" bpmnElement="Part_Core01_TimKiem_LuaChon_ThanhToan" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="3420" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Cust_di" bpmnElement="Lane_Cust" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="3390" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="3390" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Backend_di" bpmnElement="Lane_Backend" isHorizontal="true">
        <dc:Bounds x="190" y="540" width="3390" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payment_di" bpmnElement="Lane_Payment" isHorizontal="true">
        <dc:Bounds x="190" y="780" width="3390" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Airline_di" bpmnElement="Lane_Airline" isHorizontal="true">
