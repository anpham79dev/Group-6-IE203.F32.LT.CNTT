      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="2780" y="900" />
        <di:waypoint x="2840" y="900" />
      </bpmndi:BPMNEdge>
      
      <!-- f14: g4 -> t11 (Lỗi / Không đủ tiền) -->
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14">
