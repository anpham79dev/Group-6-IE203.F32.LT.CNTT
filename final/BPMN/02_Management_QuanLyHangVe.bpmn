<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_QuanLyHangVe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_02">
    <bpmn:participant id="Participant_MoMo_FareClass" name="Quy trình Quản lý Hạng vé Máy bay" processRef="Process_QuanLyHangVe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QuanLyHangVe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_02">
      <bpmn:lane id="Lane_HangBay" name="Hãng bay / Nhà cung cấp (NCC)">
        <bpmn:flowNodeRef>Start_PhatHanhHangVe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapNhatThongTinHangVe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LoaiHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CungCapRealTimeAPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuiThongTinDenMService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChinhSuaBoSungTT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BD" name="Bộ phận Business Development (BD)">
        <bpmn:flowNodeRef>Task_TichHopAPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KetQuaAPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SoLanThuAPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuaLoiTichHop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KhongTichHopDuoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TiepNhanDuLieuNoiDia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KiemTraDuLieuNoiDia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhanTichDoiChieu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChuanHoaDuLieuHangVe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ticketing" name="Bộ phận Ticketing (M_Service)">
        <bpmn:flowNodeRef>Gateway_MergeNguonHangVe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraDuLieuChuanHoa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuLieuChuanHoaDat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CauHinhHangVeHeThong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSuaLoiTicketing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XuLyLoiDieuChinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PheDuyetCongBo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QuyetDinhCongBo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CongBoHangVeApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiamSatSauCongBo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LoiPhatSinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TamHoanCongBo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Ứng dụng MoMo">
        <bpmn:flowNodeRef>Task_KiemTraHienThiDinhDang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuLieuHopLeApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HangVeOnDinh</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_PhatHanhHangVe" name="Hãng phát hành hạng vé mới">
      <bpmn:outgoing>F_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CapNhatThongTinHangVe" name="Tạo / Cập nhật thông tin hạng vé">
      <bpmn:incoming>F_01</bpmn:incoming>
      <bpmn:outgoing>F_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_01" sourceRef="Start_PhatHanhHangVe" targetRef="Task_CapNhatThongTinHangVe" />
    <bpmn:exclusiveGateway id="Gateway_LoaiHang" name="Loại hãng?">
      <bpmn:incoming>F_02</bpmn:incoming>
      <bpmn:outgoing>F_QuocTe</bpmn:outgoing>
      <bpmn:outgoing>F_NoiDia</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_CapNhatThongTinHangVe" targetRef="Gateway_LoaiHang" />
    <bpmn:task id="Task_CungCapRealTimeAPI" name="Cung cấp dữ liệu real-time qua API">
      <bpmn:incoming>F_QuocTe</bpmn:incoming>
      <bpmn:outgoing>F_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_QuocTe" name="Quốc tế" sourceRef="Gateway_LoaiHang" targetRef="Task_CungCapRealTimeAPI" />
    <bpmn:task id="Task_TichHopAPI" name="Tích hợp API">
      <bpmn:incoming>F_03</bpmn:incoming>
      <bpmn:incoming>F_RetryAPI</bpmn:incoming>
      <bpmn:outgoing>F_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_03" sourceRef="Task_CungCapRealTimeAPI" targetRef="Task_TichHopAPI" />
    <bpmn:exclusiveGateway id="Gateway_KetQuaAPI" name="Kết quả tích hợp?">
      <bpmn:incoming>F_04</bpmn:incoming>
      <bpmn:outgoing>F_APITot</bpmn:outgoing>
      <bpmn:outgoing>F_APILoi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_04" sourceRef="Task_TichHopAPI" targetRef="Gateway_KetQuaAPI" />
    <bpmn:exclusiveGateway id="Gateway_SoLanThuAPI" name="Còn trong số lần cho phép (2 lần)?">
      <bpmn:incoming>F_APILoi</bpmn:incoming>
      <bpmn:outgoing>F_ConLan</bpmn:outgoing>
      <bpmn:outgoing>F_HetLan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_APILoi" name="Thất bại" sourceRef="Gateway_KetQuaAPI" targetRef="Gateway_SoLanThuAPI" />
    <bpmn:task id="Task_SuaLoiTichHop" name="Sửa lỗi tích hợp">
      <bpmn:incoming>F_ConLan</bpmn:incoming>
      <bpmn:outgoing>F_RetryAPI</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_ConLan" name="Còn" sourceRef="Gateway_SoLanThuAPI" targetRef="Task_SuaLoiTichHop" />
    <bpmn:sequenceFlow id="F_RetryAPI" sourceRef="Task_SuaLoiTichHop" targetRef="Task_TichHopAPI" />
    <bpmn:endEvent id="End_KhongTichHopDuoc" name="Không tích hợp được API">
      <bpmn:incoming>F_HetLan</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_HetLan" name="Hết" sourceRef="Gateway_SoLanThuAPI" targetRef="End_KhongTichHopDuoc" />
    <bpmn:task id="Task_GuiThongTinDenMService" name="Gửi thông tin hạng vé đến M_Service">
      <bpmn:incoming>F_NoiDia</bpmn:incoming>
      <bpmn:incoming>F_BoSungXongNoiDia</bpmn:incoming>
      <bpmn:outgoing>F_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_NoiDia" name="Nội địa" sourceRef="Gateway_LoaiHang" targetRef="Task_GuiThongTinDenMService" />
    <bpmn:task id="Task_TiepNhanDuLieuNoiDia" name="Tiếp nhận và kiểm tra dữ liệu hạng vé">
      <bpmn:incoming>F_05</bpmn:incoming>
      <bpmn:outgoing>F_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_05" sourceRef="Task_GuiThongTinDenMService" targetRef="Task_TiepNhanDuLieuNoiDia" />
    <bpmn:exclusiveGateway id="Gateway_KiemTraDuLieuNoiDia" name="Thông tin đầy đủ và hợp lệ?">
      <bpmn:incoming>F_06</bpmn:incoming>
      <bpmn:outgoing>F_NoiDiaKhongDu</bpmn:outgoing>
      <bpmn:outgoing>F_NoiDiaDu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_06" sourceRef="Task_TiepNhanDuLieuNoiDia" targetRef="Gateway_KiemTraDuLieuNoiDia" />
    <bpmn:task id="Task_ChinhSuaBoSungTT" name="Chỉnh sửa / bổ sung thông tin hạng vé">
      <bpmn:incoming>F_NoiDiaKhongDu</bpmn:incoming>
      <bpmn:outgoing>F_BoSungXongNoiDia</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_NoiDiaKhongDu" name="Không" sourceRef="Gateway_KiemTraDuLieuNoiDia" targetRef="Task_ChinhSuaBoSungTT" />
    <bpmn:sequenceFlow id="F_BoSungXongNoiDia" sourceRef="Task_ChinhSuaBoSungTT" targetRef="Task_GuiThongTinDenMService" />
    <bpmn:task id="Task_PhanTichDoiChieu" name="Phân tích và đối chiếu thông tin hạng vé">
      <bpmn:incoming>F_NoiDiaDu</bpmn:incoming>
      <bpmn:incoming>F_ChuanHoaChuaDat</bpmn:incoming>
      <bpmn:outgoing>F_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_NoiDiaDu" name="Có" sourceRef="Gateway_KiemTraDuLieuNoiDia" targetRef="Task_PhanTichDoiChieu" />
    <bpmn:task id="Task_ChuanHoaDuLieuHangVe" name="Chuẩn hóa dữ liệu hạng vé">
      <bpmn:incoming>F_07</bpmn:incoming>
      <bpmn:outgoing>F_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_07" sourceRef="Task_PhanTichDoiChieu" targetRef="Task_ChuanHoaDuLieuHangVe" />
    <bpmn:exclusiveGateway id="Gateway_MergeNguonHangVe">
      <bpmn:incoming>F_APITot</bpmn:incoming>
      <bpmn:incoming>F_08</bpmn:incoming>
      <bpmn:outgoing>F_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_APITot" name="Thành công" sourceRef="Gateway_KetQuaAPI" targetRef="Gateway_MergeNguonHangVe" />
    <bpmn:sequenceFlow id="F_08" sourceRef="Task_ChuanHoaDuLieuHangVe" targetRef="Gateway_MergeNguonHangVe" />
    <bpmn:task id="Task_KiemTraDuLieuChuanHoa" name="Kiểm tra dữ liệu đã chuẩn hóa">
      <bpmn:incoming>F_09</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_09" sourceRef="Gateway_MergeNguonHangVe" targetRef="Task_KiemTraDuLieuChuanHoa" />
    <bpmn:exclusiveGateway id="Gateway_DuLieuChuanHoaDat" name="Dữ liệu chuẩn hóa theo yêu cầu?">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_ChuanHoaChuaDat</bpmn:outgoing>
      <bpmn:outgoing>F_ChuanHoaDat</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_KiemTraDuLieuChuanHoa" targetRef="Gateway_DuLieuChuanHoaDat" />
    <bpmn:sequenceFlow id="F_ChuanHoaChuaDat" name="Không" sourceRef="Gateway_DuLieuChuanHoaDat" targetRef="Task_PhanTichDoiChieu" />
    <bpmn:task id="Task_CauHinhHangVeHeThong" name="Cấu hình hạng vé lên hệ thống MoMo">
      <bpmn:incoming>F_ChuanHoaDat</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_ChuanHoaDat" name="Có" sourceRef="Gateway_DuLieuChuanHoaDat" targetRef="Task_CauHinhHangVeHeThong" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Task_CauHinhHangVeHeThong" targetRef="Task_KiemTraHienThiDinhDang" />
    <bpmn:task id="Task_KiemTraHienThiDinhDang" name="Kiểm tra hiển thị định dạng và cấu trúc">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DuLieuHopLeApp" name="Dữ liệu hiển thị hợp lệ?">
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_AppLoi</bpmn:outgoing>
      <bpmn:outgoing>F_AppHopLe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_12" sourceRef="Task_KiemTraHienThiDinhDang" targetRef="Gateway_DuLieuHopLeApp" />
    <bpmn:exclusiveGateway id="Gateway_MergeSuaLoiTicketing">
      <bpmn:incoming>F_AppLoi</bpmn:incoming>
      <bpmn:incoming>F_LoiSauCongBo</bpmn:incoming>
      <bpmn:outgoing>F_ToSuaLoi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_AppLoi" name="Không" sourceRef="Gateway_DuLieuHopLeApp" targetRef="Gateway_MergeSuaLoiTicketing" />
    <bpmn:task id="Task_XuLyLoiDieuChinh" name="Xử lý lỗi và điều chỉnh">
      <bpmn:incoming>F_ToSuaLoi</bpmn:incoming>
      <bpmn:outgoing>F_SuaXongKiemTraLai</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_ToSuaLoi" sourceRef="Gateway_MergeSuaLoiTicketing" targetRef="Task_XuLyLoiDieuChinh" />
    <bpmn:sequenceFlow id="F_SuaXongKiemTraLai" sourceRef="Task_XuLyLoiDieuChinh" targetRef="Task_KiemTraHienThiDinhDang" />
    <bpmn:task id="Task_PheDuyetCongBo" name="Phê duyệt công bố hạng vé">
      <bpmn:incoming>F_AppHopLe</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_AppHopLe" name="Có" sourceRef="Gateway_DuLieuHopLeApp" targetRef="Task_PheDuyetCongBo" />
    <bpmn:exclusiveGateway id="Gateway_QuyetDinhCongBo" name="Quyết định công bố?">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_KhongCongBo</bpmn:outgoing>
      <bpmn:outgoing>F_CoCongBo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_13" sourceRef="Task_PheDuyetCongBo" targetRef="Gateway_QuyetDinhCongBo" />
    <bpmn:endEvent id="End_TamHoanCongBo" name="Tạm hoãn / Hủy công bố hạng vé">
      <bpmn:incoming>F_KhongCongBo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_KhongCongBo" name="Không" sourceRef="Gateway_QuyetDinhCongBo" targetRef="End_TamHoanCongBo" />
    <bpmn:task id="Task_CongBoHangVeApp" name="Công bố hạng vé lên App MoMo">
      <bpmn:incoming>F_CoCongBo</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_CoCongBo" name="Có" sourceRef="Gateway_QuyetDinhCongBo" targetRef="Task_CongBoHangVeApp" />
    <bpmn:task id="Task_GiamSatSauCongBo" name="Giám sát theo dõi sau công bố">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_CongBoHangVeApp" targetRef="Task_GiamSatSauCongBo" />
    <bpmn:exclusiveGateway id="Gateway_LoiPhatSinh" name="Có lỗi phát sinh?">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_LoiSauCongBo</bpmn:outgoing>
      <bpmn:outgoing>F_KhongLoi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_15" sourceRef="Task_GiamSatSauCongBo" targetRef="Gateway_LoiPhatSinh" />
    <bpmn:sequenceFlow id="F_LoiSauCongBo" name="Có" sourceRef="Gateway_LoiPhatSinh" targetRef="Gateway_MergeSuaLoiTicketing" />
    <bpmn:endEvent id="End_HangVeOnDinh" name="Hạng vé hiển thị ổn định trên MoMo">
      <bpmn:incoming>F_KhongLoi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_KhongLoi" name="Không" sourceRef="Gateway_LoiPhatSinh" targetRef="End_HangVeOnDinh" />
  </bpmn:process>
