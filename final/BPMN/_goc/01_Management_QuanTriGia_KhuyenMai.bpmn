<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_QuanTriGia" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_MoMo_Pricing" name="Quy trình Quản trị Giá, Khuyến mãi và Chính sách hiển thị giá" processRef="Process_QuanTriGia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QuanTriGia" isExecutable="false">
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_HangBay" name="Hãng bay / Nhà cung cấp (NCC)">
        <bpmn:flowNodeRef>StartEvent_YeuCauGia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuiDuLieuGia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DieuChinhBoSungGia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BoPhanGia" name="Bộ phận Quản lý Giá">
        <bpmn:flowNodeRef>Task_TiepNhanGia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KiemTraDayDuGia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChuanHoaGiaThuePhi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KiemTraHopLeGia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TraLaiChuanHoa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Marketing" name="Bộ phận Marketing">
        <bpmn:flowNodeRef>Task_PhanTichKH_ChienDich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApDungKM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XayDungChinhSachKM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PhuHopKHTieu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DieuChinhMucTieuKM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThietKeCoCheKM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoSungHoSoDieuKien</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TaiChinhPhapChe" name="Bộ phận Tài chính / Pháp chế (M_Service)">
        <bpmn:flowNodeRef>Task_ThamDinhChinhSachKM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PheDuyetChinhSach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraHoSoDieuKien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HoSoDayDu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KyThuat" name="Bộ phận Growth Specialist / Kỹ thuật">
        <bpmn:flowNodeRef>Gateway_MergeChinhSach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TiepNhanChinhSachGia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TiepNhanChinhSachKM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CauHinhGiaVaHienThi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSuaCauHinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CongBoGiaKM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppMoMo" name="Ứng dụng MoMo">
        <bpmn:flowNodeRef>Task_KiemTraHienThiApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HienThiDung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CongBoThanhCong</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_YeuCauGia" name="Có yêu cầu cung cấp TT Giá/KM">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GuiDuLieuGia" name="Gửi dữ liệu giá, thuế, phí và chính sách">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_BoSungXong</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_YeuCauGia" targetRef="Task_GuiDuLieuGia" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_GuiDuLieuGia" targetRef="Task_TiepNhanGia" />
    <bpmn:task id="Task_TiepNhanGia" name="Tiếp nhận và kiểm tra dữ liệu giá">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_KiemTraDayDuGia" name="Dữ liệu đầy đủ?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_GiaDayDu_Co</bpmn:outgoing>
      <bpmn:outgoing>Flow_GiaDayDu_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_TiepNhanGia" targetRef="Gateway_KiemTraDayDuGia" />
    <bpmn:task id="Task_DieuChinhBoSungGia" name="Điều chỉnh / bổ sung dữ liệu giá/thuế/phí">
      <bpmn:incoming>Flow_GiaDayDu_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_BoSungXong</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_GiaDayDu_Khong" name="Không" sourceRef="Gateway_KiemTraDayDuGia" targetRef="Task_DieuChinhBoSungGia" />
    <bpmn:sequenceFlow id="Flow_BoSungXong" sourceRef="Task_DieuChinhBoSungGia" targetRef="Task_GuiDuLieuGia" />
    <bpmn:task id="Task_ChuanHoaGiaThuePhi" name="Chuẩn hóa giá / thuế / phí">
      <bpmn:incoming>Flow_GiaDayDu_Co</bpmn:incoming>
      <bpmn:incoming>Flow_ChuanHoaLai</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_GiaDayDu_Co" name="Có" sourceRef="Gateway_KiemTraDayDuGia" targetRef="Task_ChuanHoaGiaThuePhi" />
    <bpmn:exclusiveGateway id="Gateway_KiemTraHopLeGia" name="Giá/thuế/phí hợp lệ?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_GiaHopLe_Co</bpmn:outgoing>
      <bpmn:outgoing>Flow_GiaHopLe_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ChuanHoaGiaThuePhi" targetRef="Gateway_KiemTraHopLeGia" />
    <bpmn:task id="Task_TraLaiChuanHoa" name="Trả lại để điều chỉnh">
      <bpmn:incoming>Flow_GiaHopLe_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_ChuanHoaLai</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_GiaHopLe_Khong" name="Không" sourceRef="Gateway_KiemTraHopLeGia" targetRef="Task_TraLaiChuanHoa" />
    <bpmn:sequenceFlow id="Flow_ChuanHoaLai" sourceRef="Task_TraLaiChuanHoa" targetRef="Task_ChuanHoaGiaThuePhi" />
    <bpmn:task id="Task_PhanTichKH_ChienDich" name="Phân tích khách hàng và mục tiêu chiến dịch">
      <bpmn:incoming>Flow_GiaHopLe_Co</bpmn:incoming>
      <bpmn:incoming>Flow_DieuChinhMKTXong</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_GiaHopLe_Co" name="Có" sourceRef="Gateway_KiemTraHopLeGia" targetRef="Task_PhanTichKH_ChienDich" />
    <bpmn:exclusiveGateway id="Gateway_ApDungKM" name="Có áp dụng KM hay không?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_KM_Khong</bpmn:outgoing>
      <bpmn:outgoing>Flow_KM_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_PhanTichKH_ChienDich" targetRef="Gateway_ApDungKM" />
    <bpmn:task id="Task_TiepNhanChinhSachGia" name="Tiếp nhận chính sách giá gốc">
      <bpmn:incoming>Flow_KM_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMerge1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_KM_Khong" name="Không" sourceRef="Gateway_ApDungKM" targetRef="Task_TiepNhanChinhSachGia" />
    <bpmn:task id="Task_XayDungChinhSachKM" name="Xây dựng chính sách giá và KM">
      <bpmn:incoming>Flow_KM_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_KM_Co" name="Có" sourceRef="Gateway_ApDungKM" targetRef="Task_XayDungChinhSachKM" />
    <bpmn:exclusiveGateway id="Gateway_PhuHopKHTieu" name="Phù hợp KH mục tiêu?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_PhuHop_Khong</bpmn:outgoing>
      <bpmn:outgoing>Flow_PhuHop_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_XayDungChinhSachKM" targetRef="Gateway_PhuHopKHTieu" />
    <bpmn:task id="Task_DieuChinhMucTieuKM" name="Điều chỉnh đối tượng hoặc mục tiêu chiến dịch">
      <bpmn:incoming>Flow_PhuHop_Khong</bpmn:incoming>
      <bpmn:incoming>Flow_PheDuyet_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_DieuChinhMKTXong</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_PhuHop_Khong" name="Không" sourceRef="Gateway_PhuHopKHTieu" targetRef="Task_DieuChinhMucTieuKM" />
    <bpmn:sequenceFlow id="Flow_DieuChinhMKTXong" sourceRef="Task_DieuChinhMucTieuKM" targetRef="Task_PhanTichKH_ChienDich" />
    <bpmn:task id="Task_ThietKeCoCheKM" name="Thiết kế cơ chế khuyến mãi và điều kiện áp dụng">
      <bpmn:incoming>Flow_PhuHop_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_PhuHop_Co" name="Có" sourceRef="Gateway_PhuHopKHTieu" targetRef="Task_ThietKeCoCheKM" />
    <bpmn:task id="Task_BoSungHoSoDieuKien" name="Bổ sung / hoàn thiện hồ sơ điều kiện">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_HoSo_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ThietKeCoCheKM" targetRef="Task_BoSungHoSoDieuKien" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_BoSungHoSoDieuKien" targetRef="Task_ThamDinhChinhSachKM" />
    <bpmn:task id="Task_ThamDinhChinhSachKM" name="Thẩm định chính sách giá / khuyến mãi">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PheDuyetChinhSach" name="Chính sách được phê duyệt?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_PheDuyet_Khong</bpmn:outgoing>
      <bpmn:outgoing>Flow_PheDuyet_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ThamDinhChinhSachKM" targetRef="Gateway_PheDuyetChinhSach" />
    <bpmn:sequenceFlow id="Flow_PheDuyet_Khong" name="Không" sourceRef="Gateway_PheDuyetChinhSach" targetRef="Task_DieuChinhMucTieuKM" />
    <bpmn:task id="Task_KiemTraHoSoDieuKien" name="Kiểm tra hồ sơ điều kiện">
      <bpmn:incoming>Flow_PheDuyet_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_PheDuyet_Co" name="Có" sourceRef="Gateway_PheDuyetChinhSach" targetRef="Task_KiemTraHoSoDieuKien" />
    <bpmn:exclusiveGateway id="Gateway_HoSoDayDu" name="Hồ sơ điều kiện đầy đủ?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_HoSo_Khong</bpmn:outgoing>
      <bpmn:outgoing>Flow_HoSo_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_KiemTraHoSoDieuKien" targetRef="Gateway_HoSoDayDu" />
    <bpmn:sequenceFlow id="Flow_HoSo_Khong" name="Không" sourceRef="Gateway_HoSoDayDu" targetRef="Task_BoSungHoSoDieuKien" />
    <bpmn:task id="Task_TiepNhanChinhSachKM" name="Tiếp nhận chính sách giá / KM">
      <bpmn:incoming>Flow_HoSo_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMerge2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_HoSo_Co" name="Có" sourceRef="Gateway_HoSoDayDu" targetRef="Task_TiepNhanChinhSachKM" />
    <bpmn:exclusiveGateway id="Gateway_MergeChinhSach">
      <bpmn:incoming>Flow_ToMerge1</bpmn:incoming>
      <bpmn:incoming>Flow_ToMerge2</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToMerge1" sourceRef="Task_TiepNhanChinhSachGia" targetRef="Gateway_MergeChinhSach" />
    <bpmn:sequenceFlow id="Flow_ToMerge2" sourceRef="Task_TiepNhanChinhSachKM" targetRef="Gateway_MergeChinhSach" />
    <bpmn:exclusiveGateway id="Gateway_MergeSuaCauHinh">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_HienThi_Khong</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_MergeChinhSach" targetRef="Gateway_MergeSuaCauHinh" />
    <bpmn:task id="Task_CauHinhGiaVaHienThi" name="Cấu hình giá và chính sách hiển thị">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_MergeSuaCauHinh" targetRef="Task_CauHinhGiaVaHienThi" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CauHinhGiaVaHienThi" targetRef="Task_KiemTraHienThiApp" />
    <bpmn:task id="Task_KiemTraHienThiApp" name="Kiểm tra hiển thị giá / KM trên App">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HienThiDung" name="Hiển thị đúng giá/KM?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_HienThi_Khong</bpmn:outgoing>
      <bpmn:outgoing>Flow_HienThi_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_KiemTraHienThiApp" targetRef="Gateway_HienThiDung" />
    <bpmn:sequenceFlow id="Flow_HienThi_Khong" name="Không" sourceRef="Gateway_HienThiDung" targetRef="Gateway_MergeSuaCauHinh" />
    <bpmn:task id="Task_CongBoGiaKM" name="Công bố giá / KM">
      <bpmn:incoming>Flow_HienThi_Co</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_HienThi_Co" name="Có" sourceRef="Gateway_HienThiDung" targetRef="Task_CongBoGiaKM" />
    <bpmn:endEvent id="EndEvent_CongBoThanhCong" name="Giá/KM hiển thị trên App thành công">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CongBoGiaKM" targetRef="EndEvent_CongBoThanhCong" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_QuanTriGia">
    <bpmndi:BPMNPlane id="Plane_Process_QuanTriGia" bpmnElement="Collaboration_01">
      <bpmndi:BPMNShape id="Participant_MoMo_Pricing_di" bpmnElement="Participant_MoMo_Pricing" isHorizontal="true">
