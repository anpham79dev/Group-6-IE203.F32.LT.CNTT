      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PhanTichKH_ChienDich_di" bpmnElement="Task_PhanTichKH_ChienDich">
        <dc:Bounds x="1442" y="569" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ApDungKM_di" bpmnElement="Gateway_ApDungKM" isMarkerVisible="true">
        <dc:Bounds x="1687" y="580" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1652" y="636" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TiepNhanChinhSachGia_di" bpmnElement="Task_TiepNhanChinhSachGia">
