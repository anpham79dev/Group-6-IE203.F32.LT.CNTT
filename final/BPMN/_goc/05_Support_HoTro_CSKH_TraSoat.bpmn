    <bpmn:sequenceFlow id="H_12" sourceRef="Task_DongTicketThanhCong" targetRef="End_HoanTatCSKH" />
    <bpmn:task id="Task_HuongDanKhieuNaiTiep" name="Hướng dẫn thủ tục khiếu nại chuyên sâu và đóng ticket">
      <bpmn:incoming>H_ChapNhan_Khong</bpmn:incoming>
      <bpmn:outgoing>H_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_ChapNhan_Khong" name="Không" sourceRef="Gateway_ChapNhanGiaiPhap" targetRef="Task_HuongDanKhieuNaiTiep" />
    <bpmn:endEvent id="End_KhieuNaiNangCao" name="Chuyển sang khiếu nại cấp cao (Pháp chế)">
