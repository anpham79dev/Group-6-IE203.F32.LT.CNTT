    <bpmn:sequenceFlow id="H_KenhTongDai" name="Tổng đài" sourceRef="Gateway_KenhLienHe" targetRef="Task_TiepNhanGhiNhanTicket" />
    <bpmn:exclusiveGateway id="Gateway_PhanCapChamSoc" name="Phân hạng khách hàng?">
