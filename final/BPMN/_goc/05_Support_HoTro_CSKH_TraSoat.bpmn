      <bpmn:outgoing>H_ThieuTT</bpmn:outgoing>
      <bpmn:outgoing>H_DuTT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="H_04" sourceRef="Task_PhanTichYeuCau" targetRef="Gateway_DuThongTinXuLy" />
    <bpmn:task id="Task_YeuCauBSSuCo" name="Yêu cầu khách hàng bổ sung thông tin">
