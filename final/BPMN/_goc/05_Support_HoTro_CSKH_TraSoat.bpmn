      <bpmn:incoming>H_BoSungXong</bpmn:incoming>
      <bpmn:outgoing>H_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_03" sourceRef="Gateway_JoinChamSoc" targetRef="Task_PhanTichYeuCau" />
    <bpmn:exclusiveGateway id="Gateway_DuThongTinXuLy" name="Đủ thông tin để xử lý?">
