    <bpmn:startEvent id="Start_KhachBaoSuCo" name="Khách hàng phát sinh sự cố / khiếu nại">
      <bpmn:outgoing>H_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_KenhLienHe" name="Kênh liên hệ?">
      <bpmn:incoming>H_01</bpmn:incoming>
      <bpmn:outgoing>H_KenhApp</bpmn:outgoing>
      <bpmn:outgoing>H_KenhTongDai</bpmn:outgoing>
    </bpmn:exclusiveGateway>
