      <bpmn:outgoing>H_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_ThieuTT" name="Không" sourceRef="Gateway_DuThongTinXuLy" targetRef="Task_YeuCauBSSuCo" />
    <bpmn:task id="Task_BoSungThongTin" name="Khách hàng gửi bổ sung thông tin/chứng từ">
      <bpmn:incoming>H_05</bpmn:incoming>
      <bpmn:outgoing>H_BoSungXong</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_05" sourceRef="Task_YeuCauBSSuCo" targetRef="Task_BoSungThongTin" />
    <bpmn:sequenceFlow id="H_BoSungXong" sourceRef="Task_BoSungThongTin" targetRef="Task_PhanTichYeuCau" />
    <bpmn:exclusiveGateway id="Gateway_PhamViGiaiQuyet" name="Thuộc phạm vi giải quyết của MoMo?">
