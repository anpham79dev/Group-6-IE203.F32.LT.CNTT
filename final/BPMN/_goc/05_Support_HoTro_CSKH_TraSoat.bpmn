<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HoTroCSKH" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_05">
    <bpmn:participant id="Participant_MoMo_CustomerSupport" name="Quy trình Hỗ trợ Khách hàng và Tiếp nhận Phản hồi / Tra soát" processRef="Process_HoTroCSKH" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HoTroCSKH" isExecutable="false">
    <bpmn:laneSet id="LaneSet_05">
      <bpmn:lane id="Lane_KhachHang" name="Khách hàng">
        <bpmn:flowNodeRef>Start_KhachBaoSuCo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoSungThongTin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NhanPhanHoiHuongDan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChapNhanGiaiPhap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KhieuNaiNangCao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppMoMo" name="Ứng dụng MoMo">
