        <bpmn:flowNodeRef>Task_KenhCSKH_TieuChuan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinChamSoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhanTichYeuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuThongTinXuLy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_YeuCauBSSuCo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PhamViGiaiQuyet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HuongDanGiaiPhapNoiBo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChuyenYeuCauHangBay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TiepNhanKetQuaHang</bpmn:flowNodeRef>
