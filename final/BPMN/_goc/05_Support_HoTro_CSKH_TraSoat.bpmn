      <bpmn:outgoing>H_MoMoXuLy</bpmn:outgoing>
      <bpmn:outgoing>H_HangBayXuLy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="H_DuTT" name="Có" sourceRef="Gateway_DuThongTinXuLy" targetRef="Gateway_PhamViGiaiQuyet" />
    <bpmn:task id="Task_HuongDanGiaiPhapNoiBo" name="Cung cấp hướng dẫn / giải pháp nội bộ MoMo">
