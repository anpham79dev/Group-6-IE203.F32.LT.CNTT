    <bpmn:sequenceFlow id="H_10" sourceRef="Task_LienHeTrucTiepKH" targetRef="Task_NhanPhanHoiHuongDan" />
    <bpmn:exclusiveGateway id="Gateway_ChapNhanGiaiPhap" name="Khách hàng chấp nhận giải pháp?">
