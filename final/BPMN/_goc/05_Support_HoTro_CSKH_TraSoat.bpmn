      <bpmn:outgoing>H_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_06" sourceRef="Task_ChuyenYeuCauHangBay" targetRef="Task_HangBayKiemTraChinhSach" />
    <bpmn:exclusiveGateway id="Gateway_HangBayChapNhan" name="Yêu cầu được chấp nhận?">
      <bpmn:incoming>H_07</bpmn:incoming>
      <bpmn:outgoing>H_Hang_Co</bpmn:outgoing>
      <bpmn:outgoing>H_Hang_Khong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="H_07" sourceRef="Task_HangBayKiemTraChinhSach" targetRef="Gateway_HangBayChapNhan" />
    <bpmn:task id="Task_HangBayGuiKetQua" name="Gửi kết quả xử lý thành công về MoMo">
      <bpmn:incoming>H_Hang_Co</bpmn:incoming>
      <bpmn:outgoing>H_ToTiepNhanKetQua1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_Hang_Co" name="Có" sourceRef="Gateway_HangBayChapNhan" targetRef="Task_HangBayGuiKetQua" />
    <bpmn:task id="Task_HangBayTuChoiNeuLyDo" name="Từ chối và nêu rõ lý do theo điều kiện vé">
      <bpmn:incoming>H_Hang_Khong</bpmn:incoming>
      <bpmn:outgoing>H_ToTiepNhanKetQua2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_Hang_Khong" name="Không" sourceRef="Gateway_HangBayChapNhan" targetRef="Task_HangBayTuChoiNeuLyDo" />
    <bpmn:task id="Task_TiepNhanKetQuaHang" name="Tiếp nhận kết quả và ghi nhận Dữ liệu CSKH">
