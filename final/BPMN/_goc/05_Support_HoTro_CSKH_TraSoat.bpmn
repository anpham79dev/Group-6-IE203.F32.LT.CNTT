    <bpmn:sequenceFlow id="H_11" sourceRef="Task_NhanPhanHoiHuongDan" targetRef="Gateway_ChapNhanGiaiPhap" />
    <bpmn:task id="Task_DongTicketThanhCong" name="Xác nhận hoàn tất và Đóng Ticket">
