    <bpmn:sequenceFlow id="H_MoMoXuLy" name="Có" sourceRef="Gateway_PhamViGiaiQuyet" targetRef="Task_HuongDanGiaiPhapNoiBo" />
    <bpmn:task id="Task_ChuyenYeuCauHangBay" name="Chuyển yêu cầu tra soát sang Hãng bay/NCC">
