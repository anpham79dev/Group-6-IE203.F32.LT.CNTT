        <bpmn:flowNodeRef>Task_XacThucKiemTraTT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HienThiThongBaoApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HoanTatHoTroApp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="Bộ phận Chăm sóc Khách hàng (CSKH)">
