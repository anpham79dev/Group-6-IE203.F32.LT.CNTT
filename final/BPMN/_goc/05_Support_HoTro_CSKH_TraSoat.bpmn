      <bpmn:outgoing>H_VIP</bpmn:outgoing>
      <bpmn:outgoing>H_Thuong</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="H_02" sourceRef="Task_TiepNhanGhiNhanTicket" targetRef="Gateway_PhanCapChamSoc" />
    <bpmn:task id="Task_KenhCSKH_VIP" name="Điều phối đến Kênh CSKH VIP">
