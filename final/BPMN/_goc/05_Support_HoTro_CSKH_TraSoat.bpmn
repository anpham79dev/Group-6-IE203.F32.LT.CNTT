    <bpmn:sequenceFlow id="H_VIP" name="VIP" sourceRef="Gateway_PhanCapChamSoc" targetRef="Task_KenhCSKH_VIP" />
    <bpmn:task id="Task_KenhCSKH_TieuChuan" name="Điều phối đến Kênh CSKH Tiêu chuẩn">
