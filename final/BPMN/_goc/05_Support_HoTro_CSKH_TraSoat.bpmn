      <bpmn:incoming>H_ToTiepNhanKetQua2</bpmn:incoming>
      <bpmn:outgoing>H_ToMergeGP2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="H_ToTiepNhanKetQua1" sourceRef="Task_HangBayGuiKetQua" targetRef="Task_TiepNhanKetQuaHang" />
    <bpmn:sequenceFlow id="H_ToTiepNhanKetQua2" sourceRef="Task_HangBayTuChoiNeuLyDo" targetRef="Task_TiepNhanKetQuaHang" />
