    <bpmn:sequenceFlow id="H_ToJoinCSKH2" sourceRef="Task_KenhCSKH_TieuChuan" targetRef="Gateway_JoinChamSoc" />
    <bpmn:task id="Task_PhanTichYeuCau" name="Phân tích chi tiết yêu cầu &amp; log hệ thống">
