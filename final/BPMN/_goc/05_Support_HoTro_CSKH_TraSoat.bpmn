    <bpmn:endEvent id="End_HoanTatHoTroApp" name="Hoàn tất hỗ trợ tự động qua App">
      <bpmn:incoming>H_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="H_09" sourceRef="Task_HienThiThongBaoApp" targetRef="End_HoanTatHoTroApp" />
