<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_XuatHoaDon" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_06">
    <bpmn:participant id="Participant_MoMo_VATInvoice" name="Quy trình Tự động hóa Xuất Hóa đơn điện tử (VAT)" processRef="Process_XuatHoaDon" />
  </bpmn:collaboration>
  <bpmn:process id="Process_XuatHoaDon" isExecutable="false">
    <bpmn:laneSet id="LaneSet_06">
      <bpmn:lane id="Lane_KhachHang" name="Khách hàng">
        <bpmn:flowNodeRef>Start_NhuCauVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NhapFormVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XemHoaDonVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_XuatVATThanhCong</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppMoMo" name="Ứng dụng MoMo">
        <bpmn:flowNodeRef>Gateway_KenhYeuCauVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraTrangThaiYeuCauVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DaYeuCauChua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DaGuiYeuCauVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HienThiFormNhapVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ThongTinNhapHopLe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapNhatTrangThaiVaThongBao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MService" name="Hệ thống Core M_Service">
        <bpmn:flowNodeRef>Gateway_MergeNguonYeuCauVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraThoiHan72h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ThoiHan72h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_QuaHanXuatVAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DoiSoatDuLieuGiaoDich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuLieuDoiSoatKhop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TaoYeuCauXuatHoaDon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="Bộ phận CSKH">
        <bpmn:flowNodeRef>Task_TiepNhanYeuCauVATTongDai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraDoiSoatLienHeKH</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KeToan" name="Bộ phận Kế toán (M_Service)">
        <bpmn:flowNodeRef>Task_GoiAPISangVACOM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VACOMTiepNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GhiNhanLoiChuyenKT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_VACOM" name="Hệ thống Hóa đơn điện tử VACOM">
        <bpmn:flowNodeRef>Task_VACOMXuLyPhatHanh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PhatHanhThanhCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapNhatThatBaiVACOM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LoiPhatHanhHoaDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TraHoaDonDienTuVeMoMo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_NhuCauVAT" name="Khách hàng yêu cầu xuất hóa đơn VAT">
      <bpmn:outgoing>V_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_KenhYeuCauVAT" name="Kênh liên hệ?">
      <bpmn:incoming>V_01</bpmn:incoming>
      <bpmn:outgoing>V_KenhApp</bpmn:outgoing>
      <bpmn:outgoing>V_KenhCSKH</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_01" sourceRef="Start_NhuCauVAT" targetRef="Gateway_KenhYeuCauVAT" />
    <bpmn:task id="Task_KiemTraTrangThaiYeuCauVAT" name="Kiểm tra trạng thái yêu cầu VAT">
      <bpmn:incoming>V_KenhApp</bpmn:incoming>
      <bpmn:outgoing>V_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_KenhApp" name="App MoMo" sourceRef="Gateway_KenhYeuCauVAT" targetRef="Task_KiemTraTrangThaiYeuCauVAT" />
    <bpmn:exclusiveGateway id="Gateway_DaYeuCauChua" name="Giao dịch đã yêu cầu xuất VAT chưa?">
      <bpmn:incoming>V_02</bpmn:incoming>
      <bpmn:outgoing>V_DaYeuCau</bpmn:outgoing>
      <bpmn:outgoing>V_ChuaYeuCau</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_02" sourceRef="Task_KiemTraTrangThaiYeuCauVAT" targetRef="Gateway_DaYeuCauChua" />
    <bpmn:endEvent id="End_DaGuiYeuCauVAT" name="Hiển thị thông tin hóa đơn đã xuất">
      <bpmn:incoming>V_DaYeuCau</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="V_DaYeuCau" name="Đã yêu cầu" sourceRef="Gateway_DaYeuCauChua" targetRef="End_DaGuiYeuCauVAT" />
    <bpmn:task id="Task_HienThiFormNhapVAT" name="Hiển thị form nhập thông tin VAT">
      <bpmn:incoming>V_ChuaYeuCau</bpmn:incoming>
      <bpmn:incoming>V_NhapLaiForm</bpmn:incoming>
      <bpmn:outgoing>V_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_ChuaYeuCau" name="Chưa yêu cầu" sourceRef="Gateway_DaYeuCauChua" targetRef="Task_HienThiFormNhapVAT" />
    <bpmn:task id="Task_NhapFormVAT" name="Nhập MST, tên công ty, địa chỉ, email">
      <bpmn:incoming>V_03</bpmn:incoming>
      <bpmn:outgoing>V_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_03" sourceRef="Task_HienThiFormNhapVAT" targetRef="Task_NhapFormVAT" />
    <bpmn:exclusiveGateway id="Gateway_ThongTinNhapHopLe" name="Thông tin nhập hợp lệ?">
      <bpmn:incoming>V_04</bpmn:incoming>
      <bpmn:outgoing>V_NhapLaiForm</bpmn:outgoing>
      <bpmn:outgoing>V_FormHopLe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_04" sourceRef="Task_NhapFormVAT" targetRef="Gateway_ThongTinNhapHopLe" />
    <bpmn:sequenceFlow id="V_NhapLaiForm" name="Không hợp lệ" sourceRef="Gateway_ThongTinNhapHopLe" targetRef="Task_HienThiFormNhapVAT" />
    <bpmn:task id="Task_TiepNhanYeuCauVATTongDai" name="CSKH tiếp nhận và nhập thông tin xuất VAT">
      <bpmn:incoming>V_KenhCSKH</bpmn:incoming>
      <bpmn:outgoing>V_ToMergeNguon1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_KenhCSKH" name="Tổng đài" sourceRef="Gateway_KenhYeuCauVAT" targetRef="Task_TiepNhanYeuCauVATTongDai" />
    <bpmn:exclusiveGateway id="Gateway_MergeNguonYeuCauVAT">
      <bpmn:incoming>V_FormHopLe</bpmn:incoming>
      <bpmn:incoming>V_ToMergeNguon1</bpmn:incoming>
      <bpmn:outgoing>V_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_FormHopLe" name="Hợp lệ" sourceRef="Gateway_ThongTinNhapHopLe" targetRef="Gateway_MergeNguonYeuCauVAT" />
    <bpmn:sequenceFlow id="V_ToMergeNguon1" sourceRef="Task_TiepNhanYeuCauVATTongDai" targetRef="Gateway_MergeNguonYeuCauVAT" />
    <bpmn:task id="Task_KiemTraThoiHan72h" name="Kiểm tra điều kiện thời hạn 72h">
      <bpmn:incoming>V_05</bpmn:incoming>
      <bpmn:outgoing>V_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_05" sourceRef="Gateway_MergeNguonYeuCauVAT" targetRef="Task_KiemTraThoiHan72h" />
    <bpmn:exclusiveGateway id="Gateway_ThoiHan72h" name="Trong thời hạn 72h?">
      <bpmn:incoming>V_06</bpmn:incoming>
      <bpmn:outgoing>V_QuaHan72h</bpmn:outgoing>
      <bpmn:outgoing>V_ConHan72h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_06" sourceRef="Task_KiemTraThoiHan72h" targetRef="Gateway_ThoiHan72h" />
    <bpmn:endEvent id="End_QuaHanXuatVAT" name="Từ chối do quá thời hạn 72 giờ">
      <bpmn:incoming>V_QuaHan72h</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="V_QuaHan72h" name="Quá hạn" sourceRef="Gateway_ThoiHan72h" targetRef="End_QuaHanXuatVAT" />
    <bpmn:task id="Task_DoiSoatDuLieuGiaoDich" name="Đối soát vé, thanh toán &amp; thông tin hóa đơn">
      <bpmn:incoming>V_ConHan72h</bpmn:incoming>
      <bpmn:incoming>V_DoiSoatLai</bpmn:incoming>
      <bpmn:outgoing>V_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_ConHan72h" name="Còn hạn" sourceRef="Gateway_ThoiHan72h" targetRef="Task_DoiSoatDuLieuGiaoDich" />
    <bpmn:exclusiveGateway id="Gateway_DuLieuDoiSoatKhop" name="Dữ liệu đối chiếu khớp?">
      <bpmn:incoming>V_07</bpmn:incoming>
      <bpmn:outgoing>V_KhongKhop</bpmn:outgoing>
      <bpmn:outgoing>V_Khop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_07" sourceRef="Task_DoiSoatDuLieuGiaoDich" targetRef="Gateway_DuLieuDoiSoatKhop" />
    <bpmn:task id="Task_KiemTraDoiSoatLienHeKH" name="CSKH liên hệ khách hàng xác nhận &amp; cập nhật thông tin">
      <bpmn:incoming>V_KhongKhop</bpmn:incoming>
      <bpmn:outgoing>V_DoiSoatLai</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_KhongKhop" name="Không khớp" sourceRef="Gateway_DuLieuDoiSoatKhop" targetRef="Task_KiemTraDoiSoatLienHeKH" />
    <bpmn:sequenceFlow id="V_DoiSoatLai" sourceRef="Task_KiemTraDoiSoatLienHeKH" targetRef="Task_DoiSoatDuLieuGiaoDich" />
    <bpmn:task id="Task_TaoYeuCauXuatHoaDon" name="Tạo yêu cầu xuất hóa đơn chuyển Kế toán">
      <bpmn:incoming>V_Khop</bpmn:incoming>
      <bpmn:outgoing>V_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_Khop" name="Khớp" sourceRef="Gateway_DuLieuDoiSoatKhop" targetRef="Task_TaoYeuCauXuatHoaDon" />
    <bpmn:task id="Task_GoiAPISangVACOM" name="Kế toán gọi API tạo hóa đơn sang VACOM">
      <bpmn:incoming>V_08</bpmn:incoming>
      <bpmn:incoming>V_ThuLaiVACOM</bpmn:incoming>
      <bpmn:outgoing>V_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_08" sourceRef="Task_TaoYeuCauXuatHoaDon" targetRef="Task_GoiAPISangVACOM" />
    <bpmn:exclusiveGateway id="Gateway_VACOMTiepNhan" name="VACOM tiếp nhận thành công?">
      <bpmn:incoming>V_09</bpmn:incoming>
      <bpmn:outgoing>V_VACOMTiepNhan_Khong</bpmn:outgoing>
      <bpmn:outgoing>V_VACOMTiepNhan_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_09" sourceRef="Task_GoiAPISangVACOM" targetRef="Gateway_VACOMTiepNhan" />
    <bpmn:task id="Task_GhiNhanLoiChuyenKT" name="Ghi nhận lỗi API và gửi lại hoặc chuyển Kỹ thuật">
      <bpmn:incoming>V_VACOMTiepNhan_Khong</bpmn:incoming>
      <bpmn:outgoing>V_ThuLaiVACOM</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_VACOMTiepNhan_Khong" name="Thất bại" sourceRef="Gateway_VACOMTiepNhan" targetRef="Task_GhiNhanLoiChuyenKT" />
    <bpmn:sequenceFlow id="V_ThuLaiVACOM" sourceRef="Task_GhiNhanLoiChuyenKT" targetRef="Task_GoiAPISangVACOM" />
    <bpmn:task id="Task_VACOMXuLyPhatHanh" name="VACOM xử lý dữ liệu và ký số hóa đơn điện tử">
      <bpmn:incoming>V_VACOMTiepNhan_Co</bpmn:incoming>
      <bpmn:outgoing>V_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_VACOMTiepNhan_Co" name="Thành công" sourceRef="Gateway_VACOMTiepNhan" targetRef="Task_VACOMXuLyPhatHanh" />
    <bpmn:exclusiveGateway id="Gateway_PhatHanhThanhCong" name="Hóa đơn phát hành thành công?">
      <bpmn:incoming>V_10</bpmn:incoming>
      <bpmn:outgoing>V_PhatHanh_Khong</bpmn:outgoing>
      <bpmn:outgoing>V_PhatHanh_Co</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="V_10" sourceRef="Task_VACOMXuLyPhatHanh" targetRef="Gateway_PhatHanhThanhCong" />
    <bpmn:task id="Task_CapNhatThatBaiVACOM" name="Cập nhật trạng thái lỗi và báo Kỹ thuật">
      <bpmn:incoming>V_PhatHanh_Khong</bpmn:incoming>
      <bpmn:outgoing>V_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_PhatHanh_Khong" name="Thất bại" sourceRef="Gateway_PhatHanhThanhCong" targetRef="Task_CapNhatThatBaiVACOM" />
    <bpmn:endEvent id="End_LoiPhatHanhHoaDon" name="Xuất VAT thất bại - chuyển Kỹ thuật xử lý">
      <bpmn:incoming>V_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="V_11" sourceRef="Task_CapNhatThatBaiVACOM" targetRef="End_LoiPhatHanhHoaDon" />
    <bpmn:task id="Task_TraHoaDonDienTuVeMoMo" name="Truyền file hóa đơn điện tử (XML/PDF) về MoMo">
      <bpmn:incoming>V_PhatHanh_Co</bpmn:incoming>
      <bpmn:outgoing>V_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_PhatHanh_Co" name="Thành công" sourceRef="Gateway_PhatHanhThanhCong" targetRef="Task_TraHoaDonDienTuVeMoMo" />
    <bpmn:task id="Task_CapNhatTrangThaiVaThongBao" name="Lưu trữ CSDL, cập nhật App và gửi email cho KH">
      <bpmn:incoming>V_12</bpmn:incoming>
      <bpmn:outgoing>V_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_12" sourceRef="Task_TraHoaDonDienTuVeMoMo" targetRef="Task_CapNhatTrangThaiVaThongBao" />
    <bpmn:task id="Task_XemHoaDonVAT" name="Khách hàng xem / tải hóa đơn điện tử">
      <bpmn:incoming>V_13</bpmn:incoming>
      <bpmn:outgoing>V_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="V_13" sourceRef="Task_CapNhatTrangThaiVaThongBao" targetRef="Task_XemHoaDonVAT" />
    <bpmn:endEvent id="End_XuatVATThanhCong" name="Xuất hóa đơn VAT hoàn tất">
      <bpmn:incoming>V_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="V_14" sourceRef="Task_XemHoaDonVAT" targetRef="End_XuatVATThanhCong" />
  </bpmn:process>
