<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_QuanTriDanhMucHangBay"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_QuanTriDanhMucHangBay">
    <bpmn:participant id="Part_Onboarding" name="Thẩm định &amp; Onboarding đối tác hãng bay / nhà cung ứng mới" processRef="Process_Onboarding" />
    <bpmn:participant id="Part_ReviewDelist" name="Rà soát, cập nhật &amp; loại bỏ đối tác khỏi danh mục (định kỳ)" processRef="Process_ReviewDelist" />
    <bpmn:messageFlow id="MF_OnboardToReview" name="Đối tác đi vào vận hành chính thức &#8594; bắt đầu chu kỳ giám sát KPI/SLA" sourceRef="end_ok" targetRef="r_start" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Onboarding" name="Thẩm định &amp; Onboarding đối tác hãng bay / nhà cung ứng mới" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="ĐỐI TÁC (hãng bay/NCƯ)"><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="ĐỘI PHÁT TRIỂN ĐỐI TÁC (BD)"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>end_bad1</bpmn:flowNodeRef><bpmn:flowNodeRef>end_bad2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="ĐỘI PHÁP LÝ &amp; TUÂN THỦ"><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_4" name="ĐỘI KỸ THUẬT &amp; VẬN HÀNH SP DU LỊCH"><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>gw3</bpmn:flowNodeRef><bpmn:flowNodeRef>n5</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Đối tác gửi hồ sơ đề xuất"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="n1" name="Tiếp nhận &amp; đánh giá sơ bộ hồ sơ đối tác"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Đạt tiêu chí sơ bộ?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n2" name="Thẩm định pháp lý &amp; tuân thủ (giấy phép, AML/KYB)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw2" name="Đạt thẩm định pháp lý?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n3" name="Đàm phán &amp; ký thỏa thuận hợp tác (hoa hồng, SLA)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="n4" name="Tích hợp API kết nối &amp; kiểm thử UAT"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw3" name="UAT đạt?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n5" name="Cấu hình đối tác vào danh mục, chạy pilot nội bộ"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:task id="n6" name="Go-live chính thức &amp; giám sát KPI/SLA sau ra mắt"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_ok" name="Đối tác chính thức trong danh mục"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end_bad1" name="Từ chối – lưu hồ sơ (không đạt sơ bộ)"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end_bad2" name="Từ chối – lưu hồ sơ (không đạt pháp lý)"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="n1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="n1" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_3" sourceRef="gw1" targetRef="n2" name="Đạt" /><bpmn:sequenceFlow id="Flow_4" sourceRef="gw1" targetRef="end_bad1" name="Không đạt" /><bpmn:sequenceFlow id="Flow_5" sourceRef="n2" targetRef="gw2" /><bpmn:sequenceFlow id="Flow_6" sourceRef="gw2" targetRef="n3" name="Đạt" /><bpmn:sequenceFlow id="Flow_7" sourceRef="gw2" targetRef="end_bad2" name="Không đạt" /><bpmn:sequenceFlow id="Flow_8" sourceRef="n3" targetRef="n4" /><bpmn:sequenceFlow id="Flow_9" sourceRef="n4" targetRef="gw3" /><bpmn:sequenceFlow id="Flow_10" sourceRef="gw3" targetRef="n5" name="Đạt" /><bpmn:sequenceFlow id="Flow_11" sourceRef="gw3" targetRef="n4" name="Chưa đạt – phối hợp đối tác khắc phục lỗi, kiểm thử lại" /><bpmn:sequenceFlow id="Flow_12" sourceRef="n5" targetRef="n6" /><bpmn:sequenceFlow id="Flow_13" sourceRef="n6" targetRef="end_ok" />
  </bpmn:process>
  <bpmn:process id="Process_ReviewDelist" name="Rà soát, cập nhật và loại bỏ đối tác khỏi danh mục" isExecutable="false">
    <bpmn:laneSet id="RLaneSet_1">
      <bpmn:lane id="RLane_1" name="CSKH (Chăm sóc KH)"><bpmn:flowNodeRef>r_start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="RLane_2" name="ĐỘI VẬN HÀNH SẢN PHẨM DU LỊCH"><bpmn:flowNodeRef>r_n1</bpmn:flowNodeRef><bpmn:flowNodeRef>r_n2</bpmn:flowNodeRef><bpmn:flowNodeRef>r_gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>r_n_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>r_end_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>r_n4</bpmn:flowNodeRef><bpmn:flowNodeRef>r_end_ok2</bpmn:flowNodeRef><bpmn:flowNodeRef>r_n6</bpmn:flowNodeRef><bpmn:flowNodeRef>r_n7</bpmn:flowNodeRef><bpmn:flowNodeRef>r_end_bad</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="RLane_3" name="ĐỘI PHÁT TRIỂN ĐỐI TÁC (BD)"><bpmn:flowNodeRef>r_n3</bpmn:flowNodeRef><bpmn:flowNodeRef>r_gw2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="RLane_4" name="ĐỘI PHÁP LÝ &amp; TUÂN THỦ"><bpmn:flowNodeRef>r_n5</bpmn:flowNodeRef><bpmn:flowNodeRef>r_gw3</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="r_start" name="Định kỳ/cảnh báo: CSKH tổng hợp khiếu nại đối tác"><bpmn:outgoing>RFlow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="r_n1" name="Tổng hợp báo cáo KPI/SLA đối tác trong kỳ"><bpmn:incoming>RFlow_1</bpmn:incoming><bpmn:outgoing>RFlow_2</bpmn:outgoing></bpmn:task><bpmn:task id="r_n2" name="Đối chiếu KPI với SLA cam kết trong hợp đồng"><bpmn:incoming>RFlow_2</bpmn:incoming><bpmn:outgoing>RFlow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="r_gw1" name="Đạt SLA?"><bpmn:incoming>RFlow_3</bpmn:incoming><bpmn:outgoing>RFlow_4</bpmn:outgoing><bpmn:outgoing>RFlow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="r_n_ok" name="Cập nhật danh mục định kỳ (giá, lịch bay, khuyến mãi)"><bpmn:incoming>RFlow_4</bpmn:incoming><bpmn:outgoing>RFlow_5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="r_end_ok" name="Tiếp tục hợp tác bình thường"><bpmn:incoming>RFlow_5</bpmn:incoming></bpmn:endEvent><bpmn:task id="r_n3" name="Liên hệ đối tác, yêu cầu giải trình &amp; kế hoạch khắc phục (CAP), hạn 30 ngày"><bpmn:incoming>RFlow_6</bpmn:incoming><bpmn:outgoing>RFlow_7</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="r_gw2" name="Cải thiện đạt sau thời hạn?"><bpmn:incoming>RFlow_7</bpmn:incoming><bpmn:outgoing>RFlow_8</bpmn:outgoing><bpmn:outgoing>RFlow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="r_n4" name="Tiếp tục hợp tác, giám sát tăng cường"><bpmn:incoming>RFlow_8</bpmn:incoming><bpmn:incoming>RFlow_13</bpmn:incoming><bpmn:outgoing>RFlow_9</bpmn:outgoing></bpmn:task><bpmn:endEvent id="r_end_ok2" name="Duy trì hợp tác có giám sát"><bpmn:incoming>RFlow_9</bpmn:incoming></bpmn:endEvent><bpmn:task id="r_n5" name="Xem xét vi phạm nghiêm trọng / pháp lý, ra quyết định"><bpmn:incoming>RFlow_10</bpmn:incoming><bpmn:outgoing>RFlow_11</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="r_gw3" name="Chấm dứt hợp tác?"><bpmn:incoming>RFlow_11</bpmn:incoming><bpmn:outgoing>RFlow_12</bpmn:outgoing><bpmn:outgoing>RFlow_13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="r_n6" name="Gỡ đối tác khỏi danh mục, xử lý vé/đơn hiệu lực, lưu hồ sơ"><bpmn:incoming>RFlow_12</bpmn:incoming><bpmn:outgoing>RFlow_14</bpmn:outgoing></bpmn:task><bpmn:task id="r_n7" name="Thông báo nội bộ &amp; đối tác chính thức"><bpmn:incoming>RFlow_14</bpmn:incoming><bpmn:outgoing>RFlow_15</bpmn:outgoing></bpmn:task><bpmn:endEvent id="r_end_bad" name="Chấm dứt hợp tác – loại khỏi danh mục"><bpmn:incoming>RFlow_15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="RFlow_1" sourceRef="r_start" targetRef="r_n1" /><bpmn:sequenceFlow id="RFlow_2" sourceRef="r_n1" targetRef="r_n2" /><bpmn:sequenceFlow id="RFlow_3" sourceRef="r_n2" targetRef="r_gw1" /><bpmn:sequenceFlow id="RFlow_4" sourceRef="r_gw1" targetRef="r_n_ok" name="Đạt" /><bpmn:sequenceFlow id="RFlow_5" sourceRef="r_n_ok" targetRef="r_end_ok" /><bpmn:sequenceFlow id="RFlow_6" sourceRef="r_gw1" targetRef="r_n3" name="Không đạt" /><bpmn:sequenceFlow id="RFlow_7" sourceRef="r_n3" targetRef="r_gw2" /><bpmn:sequenceFlow id="RFlow_8" sourceRef="r_gw2" targetRef="r_n4" name="Đạt" /><bpmn:sequenceFlow id="RFlow_9" sourceRef="r_n4" targetRef="r_end_ok2" /><bpmn:sequenceFlow id="RFlow_10" sourceRef="r_gw2" targetRef="r_n5" name="Không đạt" /><bpmn:sequenceFlow id="RFlow_11" sourceRef="r_n5" targetRef="r_gw3" /><bpmn:sequenceFlow id="RFlow_12" sourceRef="r_gw3" targetRef="r_n6" name="Có" /><bpmn:sequenceFlow id="RFlow_13" sourceRef="r_gw3" targetRef="r_n4" name="Chưa chấm dứt – tạm ngưng có thời hạn, giám sát tăng cường" /><bpmn:sequenceFlow id="RFlow_14" sourceRef="r_n6" targetRef="r_n7" /><bpmn:sequenceFlow id="RFlow_15" sourceRef="r_n7" targetRef="r_end_bad" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_QuanTriDanhMucHangBay">
    <bpmndi:BPMNPlane id="BPMNPlane_QuanTriDanhMucHangBay" bpmnElement="Collab_QuanTriDanhMucHangBay">
      <bpmndi:BPMNShape id="Part_Onboarding_di" bpmnElement="Part_Onboarding" isHorizontal="true"><dc:Bounds x="0" y="0" width="1604" height="1014" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="0" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="200" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="30" y="400" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true"><dc:Bounds x="30" y="600" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="107" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="87" y="122" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n1_di" bpmnElement="n1"><dc:Bounds x="167" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="147" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1"><dc:Bounds x="344" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="324" y="329" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n2_di" bpmnElement="n2"><dc:Bounds x="410" y="460" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="390" y="544" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw2_di" bpmnElement="gw2"><dc:Bounds x="587" y="475" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="567" y="529" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n3_di" bpmnElement="n3"><dc:Bounds x="655" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="635" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n4_di" bpmnElement="n4"><dc:Bounds x="776" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw3_di" bpmnElement="gw3"><dc:Bounds x="953" y="675" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="933" y="729" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n5_di" bpmnElement="n5"><dc:Bounds x="1020" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1000" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n6_di" bpmnElement="n6"><dc:Bounds x="1242" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1222" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="1426" y="682" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1406" y="722" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_bad1_di" bpmnElement="end_bad1"><dc:Bounds x="351" y="846" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="331" y="886" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_bad2_di" bpmnElement="end_bad2"><dc:Bounds x="594" y="846" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="574" y="886" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
