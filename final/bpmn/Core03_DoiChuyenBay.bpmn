<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Core03_DoiChuyenBay_DieuChinhLichTrinh" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Core03_DoiChuyenBay_DieuChinhLichTrinh">
    <bpmn:participant id="Part_Core03_DoiChuyenBay_DieuChinhLichTrinh" name="Quy trình Đổi chuyến bay và Điều chỉnh lịch trình vé máy bay MoMo" processRef="Proc_Core03_DoiChuyenBay_DieuChinhLichTrinh" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Core03_DoiChuyenBay_DieuChinhLichTrinh" name="Quy trình Đổi chuyến bay và Điều chỉnh lịch trình vé máy bay MoMo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Core03_DoiChuyenBay_DieuChinhLichTrinh">
      <bpmn:lane id="Lane_Cust" name="KHÁCH HÀNG (Customer)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="GIAO DIỆN MOMO CLIENT APP">
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="HỆ THỐNG BACKEND MOMO TRAVEL">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="CỔNG THANH TOÁN MOMO">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="BỘ PHẬN CSKH MOMO TRAVEL">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Airline" name="HỆ THỐNG HÃNG BAY (RE-ISSUE API)">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Nhu cầu thay đổi lịch bay">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Chọn vé cần đổi &amp; Tìm chuyến bay mới">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g4" name="Vé đủ điều kiện đổi cơ bản?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f2b</bpmn:outgoing>
      <bpmn:outgoing>f2c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e4" name="Không đủ điều kiện đổi - Giữ vé cũ">
      <bpmn:incoming>f2c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t2" name="Tính phí cố định Hãng + Chênh lệch giá vé">
      <bpmn:incoming>f2b</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Đổi tự động API?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Xác nhận bảng kê chi tiết phí đổi vé">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f6b</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Tạo Support Ticket chuyển CSKH xử lý">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="CSKH liên hệ Hãng check phí &amp; Gửi link thanh toán">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g7" name="Hãng phản hồi trong hạn SLA (24h)?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f6b</bpmn:outgoing>
      <bpmn:outgoing>f6c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e7" name="Hết hạn SLA - Hủy yêu cầu, giữ vé cũ">
      <bpmn:incoming>f6c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g5" name="Khách hàng đồng ý phí đổi?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f7b</bpmn:outgoing>
      <bpmn:outgoing>f7c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e5" name="Khách hủy yêu cầu đổi vé">
      <bpmn:incoming>f7c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t5" name="Thanh toán khoản chi phí chênh lệch đổi vé">
      <bpmn:incoming>f7b</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Gửi lệnh tái phát hành vé (Re-issue) sang Hãng">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Re-issue OK?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Trích tiền phí đổi &amp; Hạch toán tài chính">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g8" name="Trích tiền thành công?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f13b</bpmn:outgoing>
      <bpmn:outgoing>f13c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e8" name="Trích tiền thất bại - Yêu cầu đổi phương thức thanh toán">
      <bpmn:incoming>f13c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t8" name="Hủy chỗ cũ, Xác nhận PNR &amp; Cấp e-Ticket mới">
      <bpmn:incoming>f13b</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g6" name="Cấp e-Ticket &amp; Cập nhật PNR thành công?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f16b</bpmn:outgoing>
      <bpmn:outgoing>f16c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t10" name="CSKH đối soát thủ công &amp; xác nhận lại PNR với Hãng">
      <bpmn:incoming>f16c</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e6" name="Đổi vé thành công (đã xử lý thủ công)">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g3" name="Trích tiền OK?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Đổi vé máy bay thành công &amp; Cấp e-Ticket mới">
      <bpmn:incoming>f16b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Hủy đổi vé - Giữ vé cũ">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Hết chỗ - Hoàn 100% phí đổi">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
