<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_Process_Onboarding"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Thẩm định &amp; Onboarding đối tác hãng bay / nhà cung ứng mới" processRef="Process_Onboarding" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Onboarding" name="Thẩm định &amp; Onboarding đối tác hãng bay / nhà cung ứng mới" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="ĐỐI TÁC (hãng bay/NCƯ)"><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="ĐỘI PHÁT TRIỂN ĐỐI TÁC (BD)"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>end_bad1</bpmn:flowNodeRef><bpmn:flowNodeRef>end_bad2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="ĐỘI PHÁP LÝ &amp; TUÂN THỦ"><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_4" name="ĐỘI KỸ THUẬT &amp; VẬN HÀNH SP DU LỊCH"><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>gw3</bpmn:flowNodeRef><bpmn:flowNodeRef>n5</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Đối tác gửi hồ sơ đề xuất"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="n1" name="Tiếp nhận &amp; đánh giá sơ bộ hồ sơ đối tác"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Đạt tiêu chí sơ bộ?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n2" name="Thẩm định pháp lý &amp; tuân thủ (giấy phép, AML/KYB)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw2" name="Đạt thẩm định pháp lý?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n3" name="Đàm phán &amp; ký thỏa thuận hợp tác (hoa hồng, SLA)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="n4" name="Tích hợp API kết nối &amp; kiểm thử UAT"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw3" name="UAT đạt?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n5" name="Cấu hình đối tác vào danh mục, chạy pilot nội bộ"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:task id="n6" name="Go-live chính thức &amp; giám sát KPI/SLA sau ra mắt"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_ok" name="Đối tác chính thức trong danh mục"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end_bad1" name="Từ chối – lưu hồ sơ (không đạt sơ bộ)"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end_bad2" name="Từ chối – lưu hồ sơ (không đạt pháp lý)"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="n1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="n1" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_3" sourceRef="gw1" targetRef="n2" name="Đạt" /><bpmn:sequenceFlow id="Flow_4" sourceRef="gw1" targetRef="end_bad1" name="Không đạt" /><bpmn:sequenceFlow id="Flow_5" sourceRef="n2" targetRef="gw2" /><bpmn:sequenceFlow id="Flow_6" sourceRef="gw2" targetRef="n3" name="Đạt" /><bpmn:sequenceFlow id="Flow_7" sourceRef="gw2" targetRef="end_bad2" name="Không đạt" /><bpmn:sequenceFlow id="Flow_8" sourceRef="n3" targetRef="n4" /><bpmn:sequenceFlow id="Flow_9" sourceRef="n4" targetRef="gw3" /><bpmn:sequenceFlow id="Flow_10" sourceRef="gw3" targetRef="n5" name="Đạt" /><bpmn:sequenceFlow id="Flow_11" sourceRef="gw3" targetRef="n4" name="Chưa đạt – phối hợp đối tác khắc phục lỗi, kiểm thử lại" /><bpmn:sequenceFlow id="Flow_12" sourceRef="n5" targetRef="n6" /><bpmn:sequenceFlow id="Flow_13" sourceRef="n6" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1604" height="1014" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="0" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="200" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="30" y="400" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true"><dc:Bounds x="30" y="600" width="1574" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="107" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="87" y="122" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n1_di" bpmnElement="n1"><dc:Bounds x="167" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="147" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1"><dc:Bounds x="344" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="324" y="329" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n2_di" bpmnElement="n2"><dc:Bounds x="410" y="460" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="390" y="544" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw2_di" bpmnElement="gw2"><dc:Bounds x="587" y="475" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="567" y="529" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n3_di" bpmnElement="n3"><dc:Bounds x="655" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="635" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n4_di" bpmnElement="n4"><dc:Bounds x="776" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw3_di" bpmnElement="gw3"><dc:Bounds x="953" y="675" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="933" y="729" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n5_di" bpmnElement="n5"><dc:Bounds x="1020" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1000" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n6_di" bpmnElement="n6"><dc:Bounds x="1142" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1122" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="1326" y="682" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1306" y="722" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_bad1_di" bpmnElement="end_bad1"><dc:Bounds x="351" y="846" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="331" y="886" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_bad2_di" bpmnElement="end_bad2"><dc:Bounds x="594" y="846" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="574" y="886" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="125" y="100" /><di:waypoint x="247" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="247" y="300" /><di:waypoint x="369" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="369" y="300" /><di:waypoint x="490" y="500" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="369" y="300" /><di:waypoint x="369" y="864" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="490" y="500" /><di:waypoint x="612" y="500" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="612" y="500" /><di:waypoint x="735" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="612" y="500" /><di:waypoint x="612" y="864" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="735" y="300" /><di:waypoint x="856" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="856" y="700" /><di:waypoint x="978" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="978" y="700" /><di:waypoint x="1100" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="978" y="700" /><di:waypoint x="856" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1100" y="700" /><di:waypoint x="1222" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1222" y="700" /><di:waypoint x="1344" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
