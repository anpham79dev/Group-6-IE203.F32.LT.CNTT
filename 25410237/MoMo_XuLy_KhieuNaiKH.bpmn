  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Tiếp nhận &amp; xử lý khiếu nại khách hàng trong đặt vé máy bay" processRef="Process_KhieuNaiKH" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KhieuNaiKH" name="Tiếp nhận &amp; xử lý khiếu nại khách hàng trong đặt vé máy bay" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="KHÁCH HÀNG"><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="CSKH"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>n2a</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="ĐỘI VẬN HÀNH SẢN PHẨM DU LỊCH"><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>n4a</bpmn:flowNodeRef><bpmn:flowNodeRef>n4b</bpmn:flowNodeRef><bpmn:flowNodeRef>gw3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_4" name="ĐỘI PHÁP LÝ &amp; TUÂN THỦ"><bpmn:flowNodeRef>n5</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Khách hàng gửi khiếu nại (hotline/chat/email)"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="n1" name="Tiếp nhận, phân loại &amp; tạo ticket"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Xử lý ngay theo kịch bản chuẩn?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n2a" name="Xử lý trực tiếp &amp; phản hồi khách"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:task id="n3" name="Liên hệ xác minh với hãng bay/đối tác"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw2" name="Có căn cứ hợp lệ?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n4a" name="Đề xuất &amp; thực hiện phương án xử lý"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:task id="n4b" name="Soạn phản hồi từ chối"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw3" name="Khách khiếu nại lần 2 / leo thang?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n5" name="Xem xét theo quy định bảo vệ người tiêu dùng"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:task id="n6" name="Đóng ticket &amp; khảo sát hài lòng"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_ok" name="Khiếu nại đã xử lý xong"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="n1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="n1" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_3" sourceRef="gw1" targetRef="n2a" name="Có" /><bpmn:sequenceFlow id="Flow_4" sourceRef="gw1" targetRef="n3" name="Không" /><bpmn:sequenceFlow id="Flow_5" sourceRef="n2a" targetRef="n6" /><bpmn:sequenceFlow id="Flow_6" sourceRef="n3" targetRef="gw2" /><bpmn:sequenceFlow id="Flow_7" sourceRef="gw2" targetRef="n4a" name="Có" /><bpmn:sequenceFlow id="Flow_8" sourceRef="gw2" targetRef="n4b" name="Không" /><bpmn:sequenceFlow id="Flow_9" sourceRef="n4a" targetRef="n6" /><bpmn:sequenceFlow id="Flow_10" sourceRef="n4b" targetRef="gw3" /><bpmn:sequenceFlow id="Flow_11" sourceRef="gw3" targetRef="n5" name="Có" /><bpmn:sequenceFlow id="Flow_12" sourceRef="gw3" targetRef="n6" name="Không" /><bpmn:sequenceFlow id="Flow_13" sourceRef="n5" targetRef="n6" /><bpmn:sequenceFlow id="Flow_14" sourceRef="n6" targetRef="end_ok" />
  </bpmn:process>
