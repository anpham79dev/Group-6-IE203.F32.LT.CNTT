  id="Definitions_Process_TraSoatGiaoDich"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Tra soát &amp; xử lý giao dịch lỗi/treo trong đặt vé máy bay" processRef="Process_TraSoatGiaoDich" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TraSoatGiaoDich" name="Tra soát &amp; xử lý giao dịch lỗi/treo trong đặt vé máy bay" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="KHÁCH HÀNG / HỆ THỐNG MOMO"><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="ĐỘI VẬN HÀNH SẢN PHẨM DU LỊCH"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>n5a</bpmn:flowNodeRef><bpmn:flowNodeRef>n5b</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="ĐỘI KỸ THUẬT"><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>n3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_4" name="HÃNG BAY / ĐỐI TÁC"><bpmn:flowNodeRef>n4b</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Hệ thống phát hiện GD bất thường / KH báo lỗi"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="n1" name="Ghi nhận ticket tra soát, đánh dấu giao dịch"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="n2" name="Kiểm tra log hệ thống nội bộ"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Xác định lỗi nội bộ?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n3" name="Khắc phục &amp; kích hoạt lại luồng xuất vé"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="n4" name="Liên hệ đối chiếu với hãng bay"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="n4b" name="Phản hồi trạng thái đặt chỗ thực tế"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw2" name="Chỉ lỗi đồng bộ (giữ được chỗ)?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n5a" name="Cập nhật lại vé cho khách"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:task id="n5b" name="Khởi tạo hoàn tiền"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:task id="n6" name="Thông báo kết quả &amp; đóng ticket"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_ok" name="Ticket tra soát hoàn tất"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="n1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="n1" targetRef="n2" /><bpmn:sequenceFlow id="Flow_3" sourceRef="n2" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_4" sourceRef="gw1" targetRef="n3" name="Có" /><bpmn:sequenceFlow id="Flow_5" sourceRef="gw1" targetRef="n4" name="Không / nghi ngờ" /><bpmn:sequenceFlow id="Flow_6" sourceRef="n3" targetRef="n6" /><bpmn:sequenceFlow id="Flow_7" sourceRef="n4" targetRef="n4b" /><bpmn:sequenceFlow id="Flow_8" sourceRef="n4b" targetRef="gw2" /><bpmn:sequenceFlow id="Flow_9" sourceRef="gw2" targetRef="n5a" name="Đúng" /><bpmn:sequenceFlow id="Flow_10" sourceRef="gw2" targetRef="n5b" name="Mất chỗ" /><bpmn:sequenceFlow id="Flow_11" sourceRef="n5a" targetRef="n6" /><bpmn:sequenceFlow id="Flow_12" sourceRef="n5b" targetRef="n6" /><bpmn:sequenceFlow id="Flow_13" sourceRef="n6" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
