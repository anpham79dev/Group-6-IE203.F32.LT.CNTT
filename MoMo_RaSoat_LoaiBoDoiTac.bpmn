<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_Process_ReviewDelist"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Rà soát, cập nhật và loại bỏ đối tác khỏi danh mục" processRef="Process_ReviewDelist" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ReviewDelist" name="Rà soát, cập nhật và loại bỏ đối tác khỏi danh mục" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="CSKH (Chăm sóc KH)"><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="ĐỘI VẬN HÀNH SẢN PHẨM DU LỊCH"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>n_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok2</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef><bpmn:flowNodeRef>n7</bpmn:flowNodeRef><bpmn:flowNodeRef>end_bad</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_3" name="ĐỘI PHÁT TRIỂN ĐỐI TÁC (BD)"><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_4" name="ĐỘI PHÁP LÝ &amp; TUÂN THỦ"><bpmn:flowNodeRef>n5</bpmn:flowNodeRef><bpmn:flowNodeRef>gw3</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Định kỳ/cảnh báo: CSKH tổng hợp khiếu nại đối tác"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="n1" name="Tổng hợp báo cáo KPI/SLA đối tác trong kỳ"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="n2" name="Đối chiếu KPI với SLA cam kết trong hợp đồng"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw1" name="Đạt SLA?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n_ok" name="Cập nhật danh mục định kỳ (giá, lịch bay, khuyến mãi)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_ok" name="Tiếp tục hợp tác bình thường"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent><bpmn:task id="n3" name="Liên hệ đối tác, yêu cầu giải trình &amp; kế hoạch khắc phục (CAP), hạn 30 ngày"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw2" name="Cải thiện đạt sau thời hạn?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n4" name="Tiếp tục hợp tác, giám sát tăng cường"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_ok2" name="Duy trì hợp tác có giám sát"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent><bpmn:task id="n5" name="Xem xét vi phạm nghiêm trọng / pháp lý, ra quyết định"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw3" name="Chấm dứt hợp tác?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="n6" name="Gỡ đối tác khỏi danh mục, xử lý vé/đơn hiệu lực, lưu hồ sơ"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task><bpmn:task id="n7" name="Thông báo nội bộ &amp; đối tác chính thức"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_bad" name="Chấm dứt hợp tác – loại khỏi danh mục"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="n1" /><bpmn:sequenceFlow id="Flow_2" sourceRef="n1" targetRef="n2" /><bpmn:sequenceFlow id="Flow_3" sourceRef="n2" targetRef="gw1" /><bpmn:sequenceFlow id="Flow_4" sourceRef="gw1" targetRef="n_ok" name="Đạt" /><bpmn:sequenceFlow id="Flow_5" sourceRef="n_ok" targetRef="end_ok" /><bpmn:sequenceFlow id="Flow_6" sourceRef="gw1" targetRef="n3" name="Không đạt" /><bpmn:sequenceFlow id="Flow_7" sourceRef="n3" targetRef="gw2" /><bpmn:sequenceFlow id="Flow_8" sourceRef="gw2" targetRef="n4" name="Đạt" /><bpmn:sequenceFlow id="Flow_9" sourceRef="n4" targetRef="end_ok2" /><bpmn:sequenceFlow id="Flow_10" sourceRef="gw2" targetRef="n5" name="Không đạt" /><bpmn:sequenceFlow id="Flow_11" sourceRef="n5" targetRef="gw3" /><bpmn:sequenceFlow id="Flow_12" sourceRef="gw3" targetRef="n6" name="Có" /><bpmn:sequenceFlow id="Flow_13" sourceRef="gw3" targetRef="n4" name="Chưa chấm dứt – tạm ngưng có thời hạn, giám sát tăng cường" /><bpmn:sequenceFlow id="Flow_14" sourceRef="n6" targetRef="n7" /><bpmn:sequenceFlow id="Flow_15" sourceRef="n7" targetRef="end_bad" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1685" height="850" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="0" width="1655" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="200" width="1655" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="30" y="400" width="1655" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true"><dc:Bounds x="30" y="600" width="1655" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="107" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="87" y="122" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n1_di" bpmnElement="n1"><dc:Bounds x="175" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="155" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n2_di" bpmnElement="n2"><dc:Bounds x="305" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="285" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw1_di" bpmnElement="gw1"><dc:Bounds x="490" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="470" y="329" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n_ok_di" bpmnElement="n_ok"><dc:Bounds x="565" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="545" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="757" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="737" y="322" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n3_di" bpmnElement="n3"><dc:Bounds x="565" y="460" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="545" y="544" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw2_di" bpmnElement="gw2"><dc:Bounds x="750" y="475" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="730" y="529" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n4_di" bpmnElement="n4"><dc:Bounds x="825" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="805" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_ok2_di" bpmnElement="end_ok2"><dc:Bounds x="1017" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="997" y="322" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n5_di" bpmnElement="n5"><dc:Bounds x="825" y="660" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="805" y="744" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw3_di" bpmnElement="gw3"><dc:Bounds x="1010" y="675" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="990" y="729" width="90" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n6_di" bpmnElement="n6"><dc:Bounds x="1085" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1065" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="n7_di" bpmnElement="n7"><dc:Bounds x="1215" y="260" width="160" height="80" /><bpmndi:BPMNLabel><dc:Bounds x="1195" y="344" width="200" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_bad_di" bpmnElement="end_bad"><dc:Bounds x="1407" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1387" y="322" width="76" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="125" y="100" /><di:waypoint x="255" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="255" y="300" /><di:waypoint x="385" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="385" y="300" /><di:waypoint x="515" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="515" y="300" /><di:waypoint x="645" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="645" y="300" /><di:waypoint x="775" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="515" y="300" /><di:waypoint x="645" y="500" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="645" y="500" /><di:waypoint x="775" y="500" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="775" y="500" /><di:waypoint x="905" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="905" y="300" /><di:waypoint x="1035" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="775" y="500" /><di:waypoint x="905" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="905" y="700" /><di:waypoint x="1035" y="700" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1035" y="700" /><di:waypoint x="1165" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1035" y="700" /><di:waypoint x="905" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1165" y="300" /><di:waypoint x="1295" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1295" y="300" /><di:waypoint x="1425" y="300" /><bpmndi:BPMNLabel /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
