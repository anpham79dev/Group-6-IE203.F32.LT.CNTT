      <bpmn:outgoing>Flow_t4_g1j</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="Kiểm tra hạn mức Ví Trả Sau và chọn kỳ hạn trả góp">
