  <bpmn:collaboration id="Collab_TimKiemSoSanhChuyenBay">
    <bpmn:participant id="Part_TimKiemSoSanhChuyenBay" name="Tìm kiếm và so sánh chuyến bay trên ứng dụng MoMo" processRef="Proc_TimKiemSoSanhChuyenBay" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_TimKiemSoSanhChuyenBay" name="Tìm kiếm và so sánh chuyến bay trên ứng dụng MoMo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TimKiemSoSanhChuyenBay">
      <bpmn:lane id="Lane_0" name="KHÁCH HÀNG">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="ỨNG DỤNG MOMO">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="DỊCH VỤ TÌM KIẾM &amp; ĐỊNH GIÁ">
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="HÃNG BAY / GDS / ĐỐI TÁC CUNG ỨNG">
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Phát sinh nhu cầu đi lại">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Mở mục “Du lịch – Đi lại” → “Vé máy bay”">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Nhập điểm đi, điểm đến, ngày bay, số hành khách, loại vé">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:incoming>Flow_t4_t2</bpmn:incoming>
      <bpmn:incoming>Flow_g6_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Kiểm tra tính hợp lệ của dữ liệu tìm kiếm">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Dữ liệu hợp lệ?">
      <bpmn:incoming>Flow_t3_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t4</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t4" name="Hiển thị cảnh báo và gợi ý chỉnh sửa tiêu chí">
      <bpmn:incoming>Flow_g1_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_t2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="Gửi yêu cầu tìm kiếm đến dịch vụ tìm kiếm chuyến bay">
      <bpmn:incoming>Flow_g1_t5</bpmn:incoming>
      <bpmn:incoming>Flow_t12_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_g2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Bộ đệm giá &amp; chỗ còn hiệu lực?">
      <bpmn:incoming>Flow_t5_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_g3</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_g4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="g3" name="Truy vấn song song nhà cung ứng">
      <bpmn:incoming>Flow_g2_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_g3_d1</bpmn:outgoing>
      <bpmn:outgoing>Flow_g3_d2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="d1" name="Trả kết quả giá &amp; chỗ trống — hãng nội địa">
      <bpmn:incoming>Flow_g3_d1</bpmn:incoming>
      <bpmn:outgoing>Flow_d1_g3j</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2" name="Trả kết quả giá &amp; chỗ trống — hãng quốc tế / GDS">
      <bpmn:incoming>Flow_g3_d2</bpmn:incoming>
      <bpmn:outgoing>Flow_d2_g3j</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="g3j" name="Hợp nhất kết quả truy vấn">
      <bpmn:incoming>Flow_d1_g3j</bpmn:incoming>
      <bpmn:incoming>Flow_d2_g3j</bpmn:incoming>
      <bpmn:outgoing>Flow_g3j_t6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="t6" name="Chuẩn hóa dữ liệu, khử trùng lặp và cập nhật bộ đệm">
      <bpmn:incoming>Flow_g3j_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_g4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g4" name="Gộp luồng dữ liệu">
      <bpmn:incoming>Flow_t6_g4</bpmn:incoming>
      <bpmn:incoming>Flow_g2_g4</bpmn:incoming>
      <bpmn:outgoing>Flow_g4_t7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t7" name="Áp dụng quy tắc giá hiển thị: thuế, phí, ưu đãi MoMo">
      <bpmn:incoming>Flow_g4_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_g5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g5" name="Có chuyến bay phù hợp?">
      <bpmn:incoming>Flow_t7_g5</bpmn:incoming>
      <bpmn:outgoing>Flow_g5_t9</bpmn:outgoing>
      <bpmn:outgoing>Flow_g5_t8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t9" name="Hiển thị danh sách chuyến bay kèm giá, giờ bay, hãng khai thác">
      <bpmn:incoming>Flow_g5_t9</bpmn:incoming>
      <bpmn:outgoing>Flow_t9_t10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t8" name="Hiển thị thông báo không có kết quả và gợi ý ngày lân cận">
      <bpmn:incoming>Flow_g5_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t8_g6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t10" name="So sánh giá, giờ bay và thời gian bay giữa các hãng">
      <bpmn:incoming>Flow_t9_t10</bpmn:incoming>
      <bpmn:incoming>Flow_t11_t10</bpmn:incoming>
      <bpmn:outgoing>Flow_t10_g7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g6" name="Khách đổi tiêu chí tìm kiếm?">
      <bpmn:incoming>Flow_t8_g6</bpmn:incoming>
      <bpmn:outgoing>Flow_g6_t2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g6_e2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g7" name="Áp dụng bộ lọc / sắp xếp?">
      <bpmn:incoming>Flow_t10_g7</bpmn:incoming>
      <bpmn:outgoing>Flow_g7_t11</bpmn:outgoing>
      <bpmn:outgoing>Flow_g7_g8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Kết thúc: khách rời quy trình">
      <bpmn:incoming>Flow_g6_e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t11" name="Lọc và sắp xếp lại danh sách theo tiêu chí đã chọn">
      <bpmn:incoming>Flow_g7_t11</bpmn:incoming>
      <bpmn:outgoing>Flow_t11_t10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g8" name="Phiên tìm kiếm còn hiệu lực?">
      <bpmn:incoming>Flow_g7_g8</bpmn:incoming>
      <bpmn:outgoing>Flow_g8_t12</bpmn:outgoing>
      <bpmn:outgoing>Flow_g8_g9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t12" name="Thông báo phiên hết hạn và làm mới dữ liệu">
      <bpmn:incoming>Flow_g8_t12</bpmn:incoming>
      <bpmn:outgoing>Flow_t12_t5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g9" name="Khách chọn được chuyến bay?">
      <bpmn:incoming>Flow_g8_g9</bpmn:incoming>
      <bpmn:outgoing>Flow_g9_t13</bpmn:outgoing>
      <bpmn:outgoing>Flow_g9_t14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t13" name="Chuyển sang màn hình chi tiết hành trình">
      <bpmn:incoming>Flow_g9_t13</bpmn:incoming>
      <bpmn:outgoing>Flow_t13_e1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t14" name="Lưu hành trình và bật theo dõi biến động giá">
      <bpmn:incoming>Flow_g9_t14</bpmn:incoming>
      <bpmn:outgoing>Flow_t14_e3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Đã chọn chuyến bay → chuyển Quy trình 2">
      <bpmn:incoming>Flow_t13_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Kết thúc: theo dõi giá, chưa đặt vé">
      <bpmn:incoming>Flow_t14_e3</bpmn:incoming>
    </bpmn:endEvent>
