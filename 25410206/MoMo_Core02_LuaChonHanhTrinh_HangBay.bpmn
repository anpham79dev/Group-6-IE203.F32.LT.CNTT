<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LuaChonHanhTrinhHangBay" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_LuaChonHanhTrinhHangBay">
    <bpmn:participant id="Part_LuaChonHanhTrinhHangBay" name="Lựa chọn hành trình và hãng bay trên ứng dụng MoMo" processRef="Proc_LuaChonHanhTrinhHangBay" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_LuaChonHanhTrinhHangBay" name="Lựa chọn hành trình và hãng bay trên ứng dụng MoMo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_LuaChonHanhTrinhHangBay">
      <bpmn:lane id="Lane_0" name="KHÁCH HÀNG">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="ỨNG DỤNG MOMO">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g6j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="HỆ THỐNG ĐẶT CHỖ MOMO (BOOKING CORE)">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="HÃNG BAY / GDS">
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Đã chọn chuyến bay từ kết quả tìm kiếm">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Xem chi tiết hành trình: giờ bay, điểm dừng, hãng khai thác">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:incoming>Flow_g3_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_g1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Loại hành trình?">
      <bpmn:incoming>Flow_t1_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_g1j</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t2" name="Chọn chuyến bay chiều về phù hợp">
      <bpmn:incoming>Flow_g1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_g1j</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1j" name="Gộp luồng hành trình">
      <bpmn:incoming>Flow_t2_g1j</bpmn:incoming>
      <bpmn:incoming>Flow_g1_g1j</bpmn:incoming>
      <bpmn:outgoing>Flow_g1j_t3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t3" name="Gửi yêu cầu kiểm tra lại tình trạng chỗ và giá hiện hành">
      <bpmn:incoming>Flow_g1j_t3</bpmn:incoming>
      <bpmn:incoming>Flow_t13_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_d1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d1" name="Xác nhận số chỗ trống và mức giá tại thời điểm hiện tại">
      <bpmn:incoming>Flow_t3_d1</bpmn:incoming>
      <bpmn:outgoing>Flow_d1_g2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Còn chỗ trống?">
      <bpmn:incoming>Flow_d1_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t4</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_g4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t4" name="Thông báo hết chỗ và gợi ý chuyến bay thay thế">
      <bpmn:incoming>Flow_g2_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Khách chọn chuyến khác?">
      <bpmn:incoming>Flow_t4_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_g3_t1</bpmn:outgoing>
      <bpmn:outgoing>Flow_g3_e2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Kết thúc: không chọn được hành trình">
      <bpmn:incoming>Flow_g3_e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g4" name="Giá vé thay đổi so với kết quả tìm kiếm?">
      <bpmn:incoming>Flow_g2_g4</bpmn:incoming>
      <bpmn:outgoing>Flow_g4_t5</bpmn:outgoing>
      <bpmn:outgoing>Flow_g4_g4j</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t5" name="Hiển thị mức giá cập nhật và yêu cầu xác nhận lại">
      <bpmn:incoming>Flow_g4_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_g5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g5" name="Khách chấp nhận giá mới?">
      <bpmn:incoming>Flow_t5_g5</bpmn:incoming>
      <bpmn:outgoing>Flow_g5_e3</bpmn:outgoing>
      <bpmn:outgoing>Flow_g5_g4j</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e3" name="Kết thúc: khách từ chối mức giá mới">
      <bpmn:incoming>Flow_g5_e3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g4j" name="Gộp luồng giá vé">
      <bpmn:incoming>Flow_g5_g4j</bpmn:incoming>
      <bpmn:incoming>Flow_g4_g4j</bpmn:incoming>
      <bpmn:outgoing>Flow_g4j_t7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t7" name="Hiển thị bảng so sánh hạng vé, điều kiện hoàn/đổi và quyền lợi">
      <bpmn:incoming>Flow_g4j_t7</bpmn:incoming>
      <bpmn:outgoing>Flow_t7_t6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t6" name="Chọn hạng vé và điều kiện vé phù hợp">
      <bpmn:incoming>Flow_t7_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_g6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g6" name="Mua thêm dịch vụ bổ sung?">
      <bpmn:incoming>Flow_t6_g6</bpmn:incoming>
      <bpmn:outgoing>Flow_g6_t8</bpmn:outgoing>
      <bpmn:outgoing>Flow_g6_g6j</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t8" name="Chọn hành lý ký gửi, chỗ ngồi, suất ăn, bảo hiểm du lịch/trễ chuyến">
      <bpmn:incoming>Flow_g6_t8</bpmn:incoming>
      <bpmn:outgoing>Flow_t8_g6j</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g6j" name="Gộp luồng dịch vụ">
      <bpmn:incoming>Flow_t8_g6j</bpmn:incoming>
      <bpmn:incoming>Flow_g6_g6j</bpmn:incoming>
      <bpmn:outgoing>Flow_g6j_t9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t9" name="Nhập thông tin hành khách và thông tin liên hệ">
      <bpmn:incoming>Flow_g6j_t9</bpmn:incoming>
      <bpmn:incoming>Flow_t11_t9</bpmn:incoming>
      <bpmn:outgoing>Flow_t9_t10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t10" name="Kiểm tra định dạng họ tên, ngày sinh, giấy tờ tùy thân">
      <bpmn:incoming>Flow_t9_t10</bpmn:incoming>
      <bpmn:outgoing>Flow_t10_g7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g7" name="Thông tin hành khách hợp lệ?">
      <bpmn:incoming>Flow_t10_g7</bpmn:incoming>
      <bpmn:outgoing>Flow_g7_t11</bpmn:outgoing>
      <bpmn:outgoing>Flow_g7_t12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t11" name="Báo lỗi chi tiết và yêu cầu nhập lại">
      <bpmn:incoming>Flow_g7_t11</bpmn:incoming>
      <bpmn:outgoing>Flow_t11_t9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t12" name="Gửi yêu cầu giữ chỗ tạm (hold) tới hãng bay">
      <bpmn:incoming>Flow_g7_t12</bpmn:incoming>
      <bpmn:outgoing>Flow_t12_d2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2" name="Cấp mã giữ chỗ tạm và thời hạn thanh toán">
      <bpmn:incoming>Flow_t12_d2</bpmn:incoming>
      <bpmn:outgoing>Flow_d2_g8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g8" name="Giữ chỗ thành công?">
      <bpmn:incoming>Flow_d2_g8</bpmn:incoming>
      <bpmn:outgoing>Flow_g8_t13</bpmn:outgoing>
      <bpmn:outgoing>Flow_g8_t14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t13" name="Thông báo lỗi giữ chỗ và đề nghị thử lại">
      <bpmn:incoming>Flow_g8_t13</bpmn:incoming>
      <bpmn:outgoing>Flow_t13_t3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t14" name="Tạo đơn đặt chỗ, tính tổng giá và khóa giá trong thời hạn giữ chỗ">
      <bpmn:incoming>Flow_g8_t14</bpmn:incoming>
      <bpmn:outgoing>Flow_t14_e1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Đơn đặt chỗ sẵn sàng → chuyển Quy trình 3">
      <bpmn:incoming>Flow_t14_e1</bpmn:incoming>
    </bpmn:endEvent>
